px solid #e2e9f2;border-radius:12px;padding:10px}.location-card+.location-card{margin-top:8px}.location-card strong{font-size:.78rem}.location-card p{margin:3px 0 8px;color:var(--muted);font-size:.67rem}.location-stats{display:flex;gap:10px;flex-wrap:wrap;font-size:.67rem}.heat-topic-card{border:1px solid #e2e9f2;border-radius:12px;padding:10px}.heat-topic-card+.heat-topic-card{margin-top:8px}.heat-topic-card h3{margin:0 0 8px;font-size:.78rem}.heat-mini-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:6px}.heat-mini{border-radius:8px;padding:8px;font-size:.67rem}.heat-mini b{display:block;font-size:.77rem;margin-bottom:2px}dialog{width:min(760px,calc(100vw - 24px));max-height:88vh;border:0;border-radius:18px;padding:0;box-shadow:0 24px 80px rgba(10,25,60,.28);color:var(--ink)}dialog::backdrop{background:rgba(12,24,54,.45);backdrop-filter:blur(3px)}.modal-head{position:sticky;top:0;z-index:2;display:flex;justify-content:space-between;gap:12px;align-items:flex-start;padding:15px 16px;background:#fff;border-bottom:1px solid var(--line)}.modal-head h2{margin:0;font-size:1.05rem}.modal-head p{margin:3px 0 0;color:var(--muted);font-size:.68rem}.modal-close{width:34px;height:34px;border:1px solid #d8e0eb;border-radius:10px;background:#f8fafc;font-size:1.1rem;cursor:pointer}.modal-body{padding:15px 16px 20px;overflow:auto}.modal-prompt{font-size:.95rem;line-height:1.45;font-weight:800;margin:0 0 12px}.modal-metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-bottom:15px}.modal-metric{background:#f7f9fc;border-radius:10px;padding:9px}.modal-metric b{display:block;font-size:.9rem}.modal-metric span{color:var(--muted);font-size:.61rem}.dist-title{font-size:.74rem;font-weight:900;margin:12px 0 7px}.dist-row{display:grid;grid-template-columns:minmax(0,1fr) 2fr 72px;gap:8px;align-items:center;padding:7px 0;border-bottom:1px solid #eef2f6}.dist-label{font-size:.72rem;line-height:1.3}.dist-label.correct{color:var(--good);font-weight:850}.dist-values{text-align:right;font-size:.65rem;color:var(--muted)}.dist-values b{display:block;color:var(--ink);font-size:.72rem}.combo-list{margin:0;padding-left:19px;color:var(--muted);font-size:.7rem;line-height:1.55}.sample-note{margin-top:10px;color:var(--muted);font-size:.64rem;line-height:1.4}.field input[type=date]{height:38px!important;min-height:38px!important;max-height:38px!important;line-height:38px!important;padding-top:0!important;padding-bottom:0!important;-webkit-appearance:none;appearance:none}.meta-actions{display:flex;align-items:center;gap:8px}.refresh{height:32px;border:1px solid #cfd9e8;border-radius:9px;background:#fff;color:#274d9a;font-weight:850;font-size:.7rem;padding:0 10px;cursor:pointer}.refresh:disabled{opacity:.55;cursor:default}.toast{position:fixed;left:50%;bottom:max(18px,env(safe-area-inset-bottom));transform:translate(-50%,14px);z-index:50;max-width:min(440px,calc(100vw - 28px));padding:10px 13px;border-radius:12px;background:#122655;color:#fff;box-shadow:0 12px 35px rgba(15,31,69,.28);font-size:.75rem;font-weight:800;opacity:0;pointer-events:none;transition:opacity .18s ease,transform .18s ease}.toast.show{opacity:1;transform:translate(-50%,0)}.activity-grid{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(320px,.8fr);gap:14px}.activity-panel{min-width:0}.activity-panel h3{margin:0 0 3px;font-size:.8rem}.activity-panel .activity-sub{display:block;color:var(--muted);font-size:.64rem;margin-bottom:8px}.peak-summary{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;margin-bottom:9px}.peak-card{background:#f7f9fc;border:1px solid #e5ebf4;border-radius:10px;padding:9px}.peak-card b{display:block;font-size:.83rem}.peak-card span{display:block;color:var(--muted);font-size:.59rem;margin-top:2px}.hour-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:4px;align-items:end;height:118px;padding:8px 4px 2px;border-bottom:1px solid #e7ecf3}.hour-col{display:grid;grid-template-rows:1fr auto;gap:4px;align-items:end;height:100%;min-width:0}.hour-bar{width:100%;min-height:3px;border-radius:5px 5px 2px 2px;background:linear-gradient(180deg,#4f79df,#2757c6)}.hour-label{text-align:center;font-size:.52rem;color:var(--muted);white-space:nowrap}.peak-list{margin-top:8px;display:flex;gap:6px;flex-wrap:wrap}.peak-pill{display:inline-flex;gap:4px;align-items:center;padding:5px 7px;border-radius:999px;background:#edf3ff;color:#284c94;font-size:.62rem;font-weight:800}\n@media(max-width:1100px){.filters{grid-template-columns:repeat(4,1fr);position:static}.overview{grid-template-columns:repeat(3,1fr)}.grid2{grid-template-columns:1fr}.needs-grid{grid-template-columns:repeat(2,1fr)}}\n@media(max-width:650px){.top{padding:16px 14px}.topin{align-items:flex-start;flex-direction:column}.top p{font-size:.8rem}.study-link{display:none}main{padding:9px}.filters{grid-template-columns:1fr 1fr;padding:9px;gap:7px}.filters .cohort{grid-column:1}.filters .mode{grid-column:2}.filters .country{grid-column:1}.filters .region{grid-column:2}.filters .city{grid-column:1}.filters .category{grid-column:2}.filters .from{grid-column:1}.filters .to{grid-column:2}.filters .clear{grid-column:1 / -1}.field label{font-size:.61rem}.field select,.field input{height:37px;font-size:.74rem;padding:7px 8px}.field input[type=date]{height:37px!important;min-height:37px!important;max-height:37px!important;line-height:37px!important;padding:0 8px!important}.meta-actions{width:100%;justify-content:space-between}.refresh{height:31px}.activity-grid{grid-template-columns:1fr;gap:12px}.hour-grid{grid-template-columns:repeat(6,minmax(0,1fr));height:auto;align-items:stretch;padding:0;border-bottom:0}.hour-col{height:82px}.hour-col:nth-child(n+7){margin-top:4px}.hour-label{font-size:.56rem}.peak-summary{grid-template-columns:1fr 1fr}.toast{font-size:.7rem}.overview{grid-template-columns:repeat(2,1fr);gap:7px}.card{padding:10px}.card .v{font-size:1.2rem}.section{padding:11px}.grid2{gap:9px;margin-top:9px}.meta{flex-direction:column;gap:3px;margin:8px 2px 10px}.section-head{align-items:flex-start;gap:7px}.section-head .headcopy span{display:block;margin-top:2px}.section-actions{justify-content:flex-end}.sort-select{max-width:150px;padding:6px 7px}.needs-grid{grid-template-columns:1fr}.desktop-table{display:none}.mobile-only,.location-cards,.question-cards,.heat-cards{display:block}.heat-desktop{display:none}.question-card{padding:10px}.mini-metrics{grid-template-columns:repeat(3,1fr)}.modal-metrics{grid-template-columns:repeat(2,1fr)}.dist-row{grid-template-columns:minmax(0,1fr) 1.35fr 62px}.barrow{grid-template-columns:minmax(92px,1.1fr) 1.7fr 58px}.foot{padding:0 12px 24px}.modal-body{padding:13px}.modal-head{padding:13px}.modal-prompt{font-size:.88rem}}\n</style>\n</head>\n<body>\n<header class=\"top\"><div class=\"topin\"><div><h1>SCP Study — Instructor Dashboard</h1></div><a class=\"study-link\" href=\"https://scp-study.ksariash.workers.dev/\"