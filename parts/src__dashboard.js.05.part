tempts · ${r.learners} learners</span></div></div></button>`}).join('');$('questions').innerHTML=`<div class=\"tablewrap desktop-table\"><table><thead><tr><th>Q</th><th>Question</th><th>Topic</th><th class=\"num\">First</th><th class=\"num\">Eventual</th><th class=\"num\">Recovered</th><th class=\"num\">Learners</th><th class=\"num\">Attempts</th><th>Typical time</th><th>Common wrong answer</th><th class=\"num\">Audio</th><th class=\"num\">Glossary</th></tr></thead><tbody>${body}</tbody></table></div><div class=\"question-cards\">${cards}</div>`}\nfunction heatStyle(value,type){const v=Math.max(0,Math.min(1,value||0));if(type==='usage'){return `background:hsl(218 75% ${96-v*24}%);color:${v>.55?'#fff':'#173260'}`};if(type==='time'){const hue=120*(1-v),light=95-v*20;return `background:hsl(${hue} 62% ${light}%);color:${v>.62?'#fff':'#442615'}`};const hue=120*v,light=95-(Math.abs(v-.5)*8+v*12);return `background:hsl(${hue} 58% ${light}%);color:${v<.36?'#6f1d29':v>.72?'#14543b':'#4b3a14'}`}\nfunction heatCell(label,value,den,type='perf',sub=''){const numeric=den?ratio(value,den):0;return `<span class=\"heat-cell\" style=\"${heatStyle(numeric,type)}\">${den?pct(value,den):'—'}${sub?`<span class=\"heat-sub\">${esc(sub)}</span>`:''}</span>`}\nfunction renderHeatmap(rows){if(!rows.length){$('heatmap').innerHTML='<div class=\"empty\">No topic data for these filters.</div>';return}const sorted=[...rows].sort((a,b)=>ratio(a.firstCorrect,a.firstAttempts)-ratio(b.firstCorrect,b.firstAttempts));const desktop=sorted.map(r=>`<tr><td><strong>${esc(r.category)}</strong><span class=\"heat-sub\">${r.learners} learners · ${r.attempts} answers</span></td><td>${heatCell('',r.firstCorrect,r.firstAttempts,'perf',`n=${r.firstAttempts}`)}</td><td>${heatCell('',r.eventualCorrect,r.pairs,'perf',`n=${r.pairs}`)}</td><td>${heatCell('',r.recovered,r.firstMissed,'perf',`n=${r.firstMissed}`)}</td><td><span class=\"heat-cell\" style=\"${heatStyle(timeScore(r.timeBuckets),'time')}\">${esc(dominantTime(r.timeBuckets)||'—')}<span class=\"heat-sub\">${r.attempts} responses</span></span></td><td>${heatCell('',r.audioUsed,r.attempts,'usage',`n=${r.attempts}`)}</td><td>${heatCell('',r.glossaryUsed,r.attempts,'usage',`n=${r.attempts}`)}</td></tr>`).join('');const cards=sorted.map(r=>`<div class=\"heat-topic-card\"><h3>${esc(r.category)} <span class=\"heat-sub\">${r.learners} learners · ${r.attempts} answers</span></h3><div class=\"heat-mini-grid\"><div class=\"heat-mini\" style=\"${heatStyle(ratio(r.firstCorrect,r.firstAttempts),'perf')}\"><b>${pct(r.firstCorrect,r.firstAttempts)}</b>First accuracy · n=${r.firstAttempts}</div><div class=\"heat-mini\" style=\"${heatStyle(ratio(r.eventualCorrect,r.pairs),'perf')}\"><b>${pct(r.eventualCorrect,r.pairs)}</b>Eventually correct · n=${r.pairs}</div><div class=\"heat-mini\" style=\"${heatStyle(recoveryRate(r),'perf')}\"><b>${pct(r.recovered,r.firstMissed)}</b>Recovered · n=${r.firstMissed}</div><div class=\"heat-mini\" style=\"${heatStyle(timeScore(r.timeBuckets),'time')}\"><b>${esc(dominantTime(r.timeBuckets)||'—')}</b>Typical response time</div><div class=\"heat-mini\" style=\"${heatStyle(ratio(r.audioUsed,r.attempts),'usage')}\"><b>${pct(r.audioUsed,r.attempts)}</b>Audio use</div><div class=\"heat-mini\" style=\"${heatStyle(ratio(r.glossaryUsed,r.attempts),'usage')}\"><b>${pct(r.glossaryUsed,r.attempts)}</b>Glossary use</div></div></div>`).join('');$('heatmap').innerHTML=`<div class=\"heat-scroll heat-desktop\"><table class=\"heat-table\"><thead><tr><th>Topic</th><th>First accuracy</th><th>Eventual</th><th>Retry recovery</th><th>Response time</th><th>Audio use</th><th>Glossary use</th></tr></thead><tbody>${desktop}</tbody></table></div><div class=\"heat-cards\">${cards}</div>`}\nfunction renderNeedsReview(rows){if(!rows.length){$('needsReview').innerHTML='<div class=\"empty\">No question data for these filters.</div>';return}const base=rows.filter(r=>r.firstAttempts>=3);const eligible=(base.length?base:rows.filter(r=>r.firstAttempts>0)).sort((a,b)=>difficultyScore(b)-difficultyScore(a)).slice(0,6);$('needsReview').innerHTML=`<div class=\"needs-grid\">${eligible.map(r=>{const q=catalog.get(r.questionId);return `<button type=\"button\" class=\"need-card\" data-qid=\"${r.questionId}\"><div class=\"need-top\"><span class=\"need-q\">Q${r.questionId} · ${esc(r.category)}</span><span class=\"need-score\">${pct(r.firstCorrect,r.firstAttempts)} first</span></div><div class=\"need-prompt\">${esc(q?.prompt||'')}</div><div class=\"need-meta\"><span>n=${r.firstAttempts} first attempts</span><span>Typical: ${esc(dominantTime(r.timeBuckets)||'—')}</span><span>Top distractor: ${pct(r.commonWrongCount,r.wrongAttempts)}</span></div></button>`}).join('')}</div>`}\nfunction renderTimeline(rows){if(!rows.length){$('timeline').innerHTML='<div class=\"empty\">No activity for these filters.</div>';return}const max=Math.max(...rows.map(r=>r.submissions),1);$('timeline').innerHTML=rows.slice(-90).map(r=>`<div class=\"barrow\"><div class=\"barlabel\">${esc(r.day)}</div><div class=\"track\"><div class=\"fill\" style=\"width:${100*r.submissions/max}%\"></div></div><div class=\"barvalue\">${r.submissions}<span class=\"heat-sub\">${r.learners} learners</span></div></div>`).join('')}\nfunction hourLabel(h){const n=Number(h)||0;const suffix=n<12?'AM':'PM';const v=n%12||12;return `${v}${suffix}`}\nfunction renderPeakTimes(activity){const rows=activity?.hours||[],total=rows.reduce((n,r)=>n+(Number(r.submissions)||0),0);if(!rows.length||!total){$('peakTimes').innerHTML='<div class=\"empty\">No time-of-day data for these filters.</div>';return}const byHour=new Map(rows.map(r=>[Number(r.hour),r]));const all=Array.from({length:24},(_,hour)=>byHour.get(hour)||{hour,submissions:0,learners:0});const ranked=[...rows].filter(r=>r.submissions>0).sort((a,b)=>b.submissions-a.submissions||b.learners-a.learners);const peak=ranked[0],day=activity?.weekdays?.filter(x=>x.submissions>0).slice().sort((a,b)=>b.submissions-a.submissions)[0];const pairs=all.filter((_,i)=>i%2===0).map(r=>({hour:r.hour,submissions:r.submissions+(all[r.hour+1]?.submissions||0),learners:Math.max(r.learners,all[r.hour+1]?.learners||0)}));const pairMax=Math.max(...pairs.map(r=>r.submissions),1);const cols=pairs.map(r=>{const height=Math.max(r.submissions?8:2,100*r.submissions/pairMax);return `<div class=\"hour-col\" title=\"${hourLabel(r.hour)}–${hourLabel((r.hour+2)%24)} · ${r.submissions} answers\"><div class=\"hour-bar\" style=\"height:${height}%\"></div><div class=\"hour-label\">${hourLabel(r.hour)}</div></div>`}).join('');const peaks=ranked.slice(0,3).map(r=>`<span class=\"peak-pill\">${hourLabel(r.hour)} · ${r.submissions} answers</span>`).join('');$('peakTimes').innerHTML=`<div class=\"peak-summary\"><div class=\"peak-card\"><b>${peak?hourLabel(peak.hour):'—'}</b><span>Peak starting hour · ${peak?.submissions||0} answers</span></div><div class=\"peak-card\"><b>${esc(day?.weekday||'—')}</b><span>Busiest weekday · ${day?.submissions||0} ans