export const DASHBOARD_HTML = "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\" />\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\" />\n<meta name=\"theme-color\" content=\"#14265c\" />\n<title>SCP Study — Instructor Dashboard</title>\n<style>\n:root{--navy:#14265c;--blue:#2456d3;--ink:#17213b;--muted:#69758b;--line:#dde5f0;--bg:#f4f7fb;--card:#fff;--good:#19744c;--warn:#a66400;--bad:#b92d3d;--soft:#eef3fb}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif}button,select,input{font:inherit}a{color:inherit}.top{background:linear-gradient(135deg,#102151,#1b3779);color:#fff;padding:22px max(18px,calc((100vw - 1420px)/2));box-shadow:0 7px 25px rgba(17,34,80,.16)}.topin{display:flex;justify-content:space-between;gap:20px;align-items:flex-end}.top h1{margin:0;font-size:clamp(1.45rem,2.4vw,2rem)}.top p{margin:5px 0 0;color:#d6e0ff;font-size:.88rem}.study-link{font-size:.78rem;font-weight:800;text-decoration:none;padding:9px 12px;border:1px solid rgba(255,255,255,.24);border-radius:10px;background:rgba(255,255,255,.08)}main{max-width:1420px;margin:0 auto;padding:18px}.filters,.card,.section{background:var(--card);border:1px solid var(--line);border-radius:16px;box-shadow:0 7px 22px rgba(24,41,75,.045)}.filters{padding:12px;display:grid;grid-template-columns:repeat(9,minmax(105px,1fr));gap:9px;position:sticky;top:8px;z-index:5}.field{display:grid;gap:4px;min-width:0}.field label{font-size:.64rem;text-transform:uppercase;letter-spacing:.055em;font-weight:850;color:#748098}.field select,.field input{width:100%;min-width:0;height:38px;padding:8px 9px;border:1px solid #d4ddea;border-radius:10px;background:#fff;color:var(--ink);font-size:.77rem}.clear{align-self:end;height:38px;border:1px solid #cfd9e8;border-radius:10px;background:#f7f9fc;color:#38527f;font-weight:800;cursor:pointer}.meta{display:flex;justify-content:space-between;gap:12px;margin:10px 2px 12px;color:var(--muted);font-size:.73rem}.overview{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px}.card{padding:13px}.card .k{display:block;color:var(--muted);font-size:.66rem;font-weight:800;text-transform:uppercase;letter-spacing:.04em}.card .v{display:block;margin-top:5px;font-size:1.48rem;font-weight:900;letter-spacing:-.03em}.card .s{display:block;margin-top:3px;color:var(--muted);font-size:.68rem}.grid2{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:14px;margin-top:14px}.section{padding:15px;min-width:0}.section h2{margin:0;font-size:1rem}.section-head{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:10px}.section-head .headcopy{min-width:0}.section-head span{color:var(--muted);font-size:.7rem}.section-actions{display:flex;gap:7px;align-items:center;flex-wrap:wrap}.sort-select{padding:7px 9px;border:1px solid #d4ddea;border-radius:9px;background:#fff;color:var(--ink);font-size:.7rem;font-weight:750}.tablewrap{overflow:auto;border:1px solid #e7ecf3;border-radius:12px}table{width:100%;border-collapse:collapse;font-size:.76rem}th,td{padding:9px 10px;border-bottom:1px solid #edf1f6;text-align:left;vertical-align:top}th{position:sticky;top:0;background:#f7f9fc;color:#69758b;font-size:.64rem;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap}tbody tr:last-child td{border-bottom:0}.num{text-align:right;font-variant-numeric:tabular-nums}.pill{display:inline-block;padding:3px 7px;border-radius:999px;background:#eef3fb;color:#3c5682;font-size:.65rem;font-weight:800}.low{color:var(--bad);font-weight:850}.mid{color:var(--warn);font-weight:850}.high{color:var(--good);font-weight:850}.barrow{displax:grid;grid-template-columns:minmax(120px,1.2fr) 2.4fr 64px;gap:8px;align-items:center;padding:7px 0;border-bottom:1px solid #eef2f6}.barrow:last-child{border-bottom:0}.barlabel{font-size:.75rem;font-weight:750;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.track{height:9px;border-radius:99px;background:#edf1f6;overflow:hidden}.fill{height:100%;background:linear-gradient(90deg,#315fd1,#5b82e7);border-radius:99px}.barvalue{text-align:right;font-size:.72rem;font-weight:850}.question-btn{appearance:none;border:0;background:none;padding:0;color:inherit;text-align:left;font-weight:800;line-height:1.35;cursor:pointer}.question-btn:hover{text-decoration:underline}.wrong{display:block;max-width:310px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.empty{padding:25px;text-align:center;color:var(--muted)}.foot{max-width:1420px;margin:0 auto;padding:0 18px 28px;color:#7a8497;font-size:.68rem;line-height:1.45}.loading{opacity:.58;pointer-events:none}.error{margin:12px 0;padding:11px 13px;border:1px solid #f0cbd0;background:#fff5f6;color:#8b2633;border-radius:12px;font-size:.78rem}.hidden{display:none!important}.mobile-only{display:none}.needs-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}.need-card{border:1px solid #e4eaf3;background:#fbfcfe;border-radius:12px;padding:11px;cursor:pointer;text-align:left;color:inherit}.need-card:hover{border-color:#b9c9e5}.need-top{display:flex;justify-content:space-between;gap:8px;align-items:flex-start}.need-q{font-weight:900}.need-score{font-size:.68rem;font-weight:900;color:var(--bad)}.need-prompt{margin-top:6px;font-size:.73rem;font-weight:750;line-height:1.35}.need-meta{margin-top:8px;display:flex;gap:6px;flex-wrap:wrap;color:var(--muted);font-size:.65rem}.heat-scroll{overflow:auto}.heat-table{min-width:760px}.heat-table td,.heat-table th{text-align:center}.heat-table td:first-child,.heat-table th:first-child{text-align:left;position:sticky;left:0;z-index:2;background:#fff}.heat-table th:first-child{background:#f7f9fc}.heat-cell{border-radius:8px;padding:7px 6px;font-weight:850;font-variant-numeric:tabular-nums;display:block;min-width:70px}.heat-sub{display:block;margin-top:2px;font-size:.58rem;font-weight:700;opacity:.75}.legend{display:flex;gap:9px;align-items:center;flex-wrap:wrap;color:var(--muted);font-size:.63rem}.legend-dot{width:11px;height:11px;border-radius:3px;display:inline-block;vertical-align:-2px;margin-right:3px}.location-cards,.question-cards,.heat-cards{display:none}.question-card{width:100%;appearance:none;border:1px solid #e2e9f2;border-radius:12px;background:#fff;text-align:left;padding:11px;color:inherit}.question-card+.question-card{margin-top:8px}.question-card-top{display:flex;justify-content:space-between;gap:8px;align-items:flex-start}.question-card-title{font-size:.8rem;font-weight:850;line-height:1.35}.question-card-id{flex:0 0 auto;font-size:.7rem;font-weight:900;color:#3156a3}.mini-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:9px}.mini-metric{background:#f7f9fc;border-radius:8px;padding:7px}.mini-metric b{display:block;font-size:.75rem}.mini-metric span{display:block;color:var(--muted);font-size:.58rem;margin-top:2px}.location-card{border:1