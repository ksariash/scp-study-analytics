udes(region))$('region').value=region;const r=$('region').value;const cities=[...new Set(locs.filter(x=>(!country||x.country===country)&&(!r||x.region===r)).map(x=>x.city).filter(Boolean))].sort();fillSelect('city',cities)}\nfunction query(){const q=new URLSearchParams();filters.forEach(id=>{const v=$(id).value;if(v)q.set(id,v)});return q.toString()}\nfunction syncUrl(){const q=query(),u=new URL(location.href);u.search=q;history.replaceState(null,'',u.pathname+(q?`?${q}`:''))}\nasync function getJSON(path){const r=await fetch(path,{cache:'no-store'});if(!r.ok)throw new Error(`${r.status} ${r.statusText}`);return r.json()}\nfunction card(k,v,s=''){return `<div class=\"card\"><span class=\"k\">${esc(k)}</span><span class=\"v\">${esc(v)}</span>${s?`<span class=\"s\">${esc(s)}</span>`:''}</div>`}\nfunction renderOverview(o){$('overview').innerHTML=card('Unique learners',o.learners,'anonymous installations')+card('Answer submissions',o.submissions)+card('First-attempt accuracy',pct(o.firstCorrect,o.firstAttempts),`${o.firstAttempts} first attempts`)+card('Eventually correct',pct(o.eventualCorrect,o.pairs),`${o.pairs} learner-question pairs`)+card('Used related audio',pct(o.audioUsed,o.submissions),`${o.audioUsed} of ${o.submissions} answers`)+card('Opened glossary',pct(o.glossaryUsed,o.submissions),`${o.glossaryUsed} of ${o.submissions} answers`)}\nfunction dominantTime(hist){if(!hist?.length)return null;return [...hist].sort((a,b)=>b.n-a.n)[0]?.bucket||null}\nfunction timeScore(hist){if(!hist?.length)return 0;let n=0,sum=0;for(const x of hist){const w=bucketOrder[x.bucket]??0;n+=x.n;sum+=x.n*w}return n?sum/n/5:0}\nfunction recoveryRate(r){return ratio(r.recovered,r.firstMissed)}\nfunction distractorRate(r){return ratio(r.commonWrongCount,r.wrongAttempts)}\nfunction difficultyScore(r){const acc=ratio(r.firstCorrect,r.firstAttempts);return (1-acc)*.62+timeScore(r.timeBuckets)*.22+distractorRate(r)*.16}\nfunction sortTopics(rows){const mode=$('topicsSort').value;return [...rows].sort((a,b)=>{if(mode==='attempts')return b.attempts-a.attempts;if(mode==='learners')return b.learners-a.learners;if(mode==='improved')return recoveryRate(b)-recoveryRate(a);if(mode==='audio')return ratio(b.audioUsed,b.attempts)-ratio(a.audioUsed,a.attempts);const ap=a.firstAttempts?ratio(a.firstCorrect,a.firstAttempts):9,bp=b.firstAttempts?ratio(b.firstCorrect,b.firstAttempts):9;return ap-bp||b.attempts-a.attempts})}\nfunction renderTopics(rows){if(!rows.length){$('topics').innerHTML='<div class=\"empty\">No data for these filters.</div>';return}const sorted=sortTopics(rows);$('topics').innerHTML=sorted.map(r=>`<div class=\"barrow\" title=\"${esc(r.category)} · ${r.firstAttempts} first attempts\"><div class=\"barlabel\">${esc(r.category)}</div><div class=\"track\"><div class=\"fill\" style=\"width:${r.firstAttempts?100*r.firstCorrect/r.firstAttempts:0}%\"></div></div><div class=\"barvalue ${pctClass(r.firstCorrect,r.firstAttempts)}\">${pct(r.firstCorrect,r.firstAttempts)}<span class=\"heat-sub\">n=${r.firstAttempts}</span></div></div>`).join('')}\nfunction renderLocations(rows){if(!rows.length){$('locations').innerHTML='<div class=\"empty\">No location data for these filters.</div>';return}const list=rows.slice(0,50);const body=list.map(r=>`<tr><td>${esc(r.city||'Unknown city')}</td><td>${esc(r.region||'—')}</td><td>${esc(countryName(r.country))}</td><td class=\"num\">${r.learners}</td><td class=\"num ${pctClass(r.firstCorrect,r.firstAttempts)}\">${pct(r.firstCorrect,r.firstAttempts)} <small>(${r.firstAttempts})</small></td><td class=\"num\">${r.submissions}</td></tr>`).join('');const cards=list.map(r=>`<div class=\"location-card\"><strong>${esc(r.city||'Unknown city')}</strong><p>${esc(r.region||'—')} · ${esc(countryName(r.country))}</p><div class=\"location-stats\"><span><b>${r.learners}</b> learners</span><span><b>${pct(r.firstCorrect,r.firstAttempts)}</b> first accuracy (n=${r.firstAttempts})</span><span><b>${r.submissions}</b> answers</span></div></div>`).join('');$('locations').innerHTML=`<div class=\"tablewrap desktop-table\"><table><thead><tr><th>City</th><th>Region</th><th>Country</th><th class=\"num\">Learners</th><th class=\"num\">First accuracy</th><th class=\"num\">Answers</th></tr></thead><tbody>${body}</tbody></table></div><div class=\"location-cards\">${cards}</div>`}\nfunction choiceSummary(q,letters){if(!q||!letters?.length)return'—';return letters.map(l=>{const i=l.charCodeAt(0)-65;return `${l}. ${q.choices[i]||''}`}).join(' · ')}\nfunction sortQuestions(rows){const mode=$('questionsSort').value;return [...rows].sort((a,b)=>{if(mode==='attempts')return b.attempts-a.attempts;if(mode==='slowest')return timeScore(b.timeBuckets)-timeScore(a.timeBuckets);if(mode==='improved')return recoveryRate(b)-recoveryRate(a);if(mode==='distractor')return distractorRate(b)-distractorRate(a);const ap=a.firstAttempts?ratio(a.firstCorrect,a.firstAttempts):9,bp=b.firstAttempts?ratio(b.firstCorrect,b.firstAttempts):9;return ap-bp||b.attempts-a.attempts})}\nfunction renderQuestions(rows){if(!rows.length){$('questions').innerHTML='<div class=\"empty\">No question data for these filters.</div>';return}const sorted=sortQuestions(rows);const body=sorted.map(r=>{const q=catalog.get(r.questionId);const wrong=r.commonWrong?.length?choiceSummary(q,r.commonWrong):'—';return `<tr><td class=\"num\"><strong>${r.questionId}</strong></td><td><button class=\"question-btn\" type=\"button\" data-qid=\"${r.questionId}\">${esc(q?.prompt||`Question ${r.questionId}`)}</button></td><td><span class=\"pill\">${esc(r.category)}</span></td><td class=\"num ${pctClass(r.firstCorrect,r.firstAttempts)}\">${pct(r.firstCorrect,r.firstAttempts)} <small>(n=${r.firstAttempts})</small></td><td class=\"num\">${pct(r.eventualCorrect,r.pairs)} <small>(n=${r.pairs})</small></td><td class=\"num\">${pct(r.recovered,r.firstMissed)} <small>(n=${r.firstMissed})</small></td><td class=\"num\">${r.learners}</td><td class=\"num\">${r.attempts}</td><td>${esc(dominantTime(r.timeBuckets)||'—')}</td><td><span class=\"wrong\" title=\"${esc(wrong)}\">${esc(wrong)}</span></td><td class=\"num\">${pct(r.audioUsed,r.attempts)}</td><td class=\"num\">${pct(r.glossaryUsed,r.attempts)}</td></tr>`}).join('');const cards=sorted.map(r=>{const q=catalog.get(r.questionId);return `<button class=\"question-card\" type=\"button\" data-qid=\"${r.questionId}\"><div class=\"question-card-top\"><div class=\"question-card-title\">${esc(q?.prompt||`Question ${r.questionId}`)}</div><span class=\"question-card-id\">Q${r.questionId}</span></div><div style=\"margin-top:6px\"><span class=\"pill\">${esc(r.category)}</span></div><div class=\"mini-metrics\"><div class=\"mini-metric\"><b class=\"${pctClass(r.firstCorrect,r.firstAttempts)}\">${pct(r.firstCorrect,r.firstAttempts)}</b><span>First · n=${r.firstAttempts}</span></div><div class=\"mini-metric\"><b>${pct(r.eventualCorrect,r.pairs)}</b><span>Eventual · n=${r.pairs}</span></div><div class=\"mini-metric\"><b>${r.attempts}</b><span>At