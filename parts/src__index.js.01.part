import { DASHBOARD_HTML, DASHBOARD_ICON_SVG, DASHBOARD_ICON_PNG_BASE64 } from './dashboard.js';
import { QUESTION_CATALOG } from './question-catalog.js';
import { ESSAY_CATALOG } from './essay-catalog.js';

const QUESTION_MAP = new Map(QUESTION_CATALOG.map(q => [Number(q.id), q]));
const ESSAY_MAP = new Map(ESSAY_CATALOG.map(essay => [String(essay.id), essay]));
const ESSAY_FACT_MAP = new Map();
for (const essay of ESSAY_CATALOG) {
  for (const fact of essay.facts || []) ESSAY_FACT_MAP.set(String(fact.id), { essay, fact });
}
const ANALYTICS_ZMAN_REGISTRY = null;
const RESPONSE_BUCKETS = new Set(['<10s', '10–29s', '30–59s', '1–2m', '2–5m', '5m+']);
const MODES = new Set(['study', 'test']);
const RESULTS = new Set(['correct', 'partial', 'incorrect']);
const GLOSSARY_SOURCES = new Set(['question', 'materials', 'other']);
const ESSAY_SOURCES = new Set(['adaptive', 'library', 'retry', 'next']);
const CURRENT_ZMAN = String(ANALYTICS_ZMAN_REGISTRY?.defaultZmanId || '2026-summer');
const ZMAN_OPTIONS = Array.isArray(ANALYTICS_ZMAN_REGISTRY?.zmanim) ? ANALYTICS_ZMAN_REGISTRY.zmanim : [];
const SUPPORTED_ZMANIM = new Set(ZMAN_OPTIONS.map(zman => String(zman.id || '')).filter(Boolean));
const LEGACY_ZMAN_KEYS = new Set(ZMAN_OPTIONS.flatMap(zman => Array.isArray(zman.legacyKeys) ? zman.legacyKeys : []).map(String));
const CURRENT_COHORT = CURRENT_ZMAN; // legacy D1 column name
const FILTER_FIELDS = new Map([
  ['chaburaRegion', 'chabura_region'], ['chabura', 'chabura'], ['zman', 'cohort'], ['cohort', 'cohort'], ['category', 'category'], ['mode', 'mode'], ['country', 'country'], ['region', 'region'], ['city', 'city']
]);

function text(value, max = 120) {
  if (value == null) return null;
  const s = String(value).trim();
  return s ? s.slice(0, max) : null;
}

function normalizeZman(value) {
  const zman = text(value, 100);
  if (!zman) return null;
  return LEGACY_ZMAN_KEYS.has(zman) ? CURRENT_ZMAN : zman;
}
const normalizeCohort = normalizeZman;

function catalogForZman(value) {
  const zman = normalizeZman(value);
  if (!zman || !SUPPORTED_ZMANIM.has(zman)) throw new Error('Unsupported zman');
  if (zman !== CURRENT_ZMAN) throw new Error('Zman catalog is not configured');
  return {
    zman,
    cohort: zman,
    questions: QUESTION_CATALOG,
    questionMap: QUESTION_MAP,
    essays: ESSAY_CATALOG,
    essayMap: ESSAY_MAP,
    essayFactMap: ESSAY_FACT_MAP
  };
}
const catalogForCohort = catalogForZman;

function profileStorageId(zman, installationId) {
  return `${zman}::${installationId}`;
}

function boolInt(value) { return value ? 1 : 0; }
function clamp(value, min, max) { return Math.max(min, Math.min(max, value)); }
function roundCoord(value) {
  const n = Number.parseFloat(value);
  return Number.isFinite(n) ? Math.round(n * 10) / 10 : null;
}
function validIsoDate(value) {
  if (!value) return null;
  const d = new Date(value);
  return Number.isNaN(d.getTime()) ? null : d.toISOString();
}
function jsonResponse(data, init = {}) {
  const headers = new Headers(init.headers || {});
  headers.set('Content-Type', 'application/json; charset=utf-8');
  headers.set('Cache-Control', 'no-store');
  headers.set('X-Robots-Tag', 'noindex, nofollow');
  return new Response(JSON.stringify(data), { ...init, headers });
}
function dashboardResponse() {
  return new Response(DASHBOARD_HTML, {
    headers: {
      'Content-Type': 'text/html; charset=utf-8',
      'Cache-Control': 'no-cache',
      'X-Robots-Tag': 'noindex, nofollow',
      'Referrer-Policy': 'no-referrer',
      'X-Content-Type-Options': 'nosniff'
    }
  });
}
function dashboardIconResponse() {
  return new Response(DASHBOARD_ICON_SVG, {
    headers: { 'Content-Type':'image/svg+xml; charset=utf-8', 'Cache-Control':'public, max-age=86400' }
  });
}
function dashboardTouchIconResponse() {
  const binary = atob(DASHBOARD_ICON_PNG_BASE64);
  const bytes = Uint8Array.from(binary, char => char.charCodeAt(0));
  return new Response(bytes, {
    headers: { 'Content-Type':'image/png', 'Cache-Control':'public, max-age=31536000, immutable' }
  });
}
function eventCors(request, env) {
  const origin = request.headers.get('Origin');
  const allowed = text(env.ALLOWED_ORIGIN, 300);
  if (!origin || !allowed || origin !== allowed) return null;
  return {
    'Access-Control-Allow-Origin': origin,
    'Access-Control-Allow-Methods': 'POST, OPTIONS',
    'Access-Control-Allow-Headers': 'Content-Type, X-SCP-Analytics-Version',
    'Access-Control-Max-Age': '86400',
    'Vary': 'Origin'
  };
}
function queryFilter(url) {
  const clauses = [];
  const params = [];
  for (const [param, column] of FILTER_FIELDS) {
    const value = text(url.searchParams.get(param), 160);
    if (!value) continue;
    clauses.push(`${column} = ?`);
    params.push(value);
  }
  const from = text(url.searchParams.get('from'), 10);
  const to = text(url.searchParams.get('to'), 10);
  if (from && /^\d{4}-\d{2}-\d{2}$/.test(from)) { clauses.push('received_at >= ?'); params.push(`${from}T00:00:00.000Z`); }
  if (to && /^\d{4}-\d{2}-\d{2}$/.test(to)) { clauses.push('received_at < ?'); const d = new Date(`${to}T00:00:00.000Z`); d.setUTCDate(d.getUTCDate()+1); params.push(d.toISOString()); }
  return { where: clauses.length ? `WHERE ${clauses.join(' AND ')}` : '', params };
}
function stmt(env, sql, params) { return env.DB.prepare(sql).bind(...params); }
function resultsOf(r) { return r?.results || []; }

function localActivity(rows) {
  const hourCounts = Array.from({ length: 24 }, (_, hour) => ({ hour, submissions: 0, learners: new Set() }));
  const weekdayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  const weekdayCounts = new Map(weekdayNames.map(day => [day, { weekday: day, submissions: 0, learners: new Set() }]));
  const dayCounts = new Map();
  const formatterCache = new Map();

  function formatter(timeZone) {
    const tz = timeZone || 'UTC';
    if (formatterCache.has(tz)) return formatterCache.get(tz);
    let f;
    try {
      f = new Intl.DateTimeFormat('en-CA', {
        timeZone: tz,
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
        weekday: 'short',
        hour: '2-digit',
        hourCycle: 'h23'
      });
      f.format(new Date(0));
    } catch (_) {
      f = new Intl.DateTimeFormat('en-CA', {
        timeZone: 'UTC',
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
        weekday: 'short',
        hour: '2-digit',
        hourCycle: 'h23'
      });
    }
    formatterCache.set(tz, f);
    return f;
  }

  for (const row of rows || []) {
    const d = new Date(row.ts);
    if (Number.isNaN(d.getTime())) continue;

    const parts = formatter(row.timezone).formatToParts(d);
    const value = type => parts.find(x => x.type === type)?.value;
    const year = value('year');
    const month = value('month');
    const day = value('day');
    const hourPart = value('hour');
    const weekday = value('weekday');

    let hour = Number(hourPart);
    if (!Number.isInteger(hour)) continue;
    if (hour === 24) hour = 0;
    hour = clamp(hour, 0, 23);

    const installationId = String(row.installation_id || '');
    const h = hourCounts[hour];
    h.submissions += 1;
    if (installationId) h.learners.add(installationId);

    const w = weekdayCounts.get(weekday) || weekdayCounts.get(weekdayNames[d.getUTCDay()]);
    if (w) {
      w.submissions += 1;
      if (installationId) w.learners.add(installationId);
    }

    if (year && month && day) {
      const localDay = `${year}-${month}-${day}`;
      if (!dayCounts.has(localDay)) {
        dayCounts.set(localDay, {
          day: localDay,
          submissions: 0,
          learners: new Set(),
          firstAttempts: 0,
          firstCorrect: 0
        });
      }
      const bucket = dayCounts.get(localDay);
      bucket.submissions += 1;
      if (installationId) bucket.learners.add(installationId);
      if (Number(row.attempt_number) === 1) {
        bucket.firstAttempts += 1;
        if (row.result === 'correct') bucket.firstCorrect += 1;
      }
    }
  }

  return {
    hours: hourCounts.map(x => ({ hour: x.hour, submissions: x.submissions, learners: x.learners.size })),
    weekdays: weekdayNames.map(day => {
      const x = weekdayCounts.get(day);
      return { weekday: day, submissions: x.submissions, learners: x.learners.size };
    }),
    days: [...dayCounts.values()]
      .sort((a, b) => a.day.localeCompare(b.day))
      .map(x => ({
        day: x.day,
        submissions: x.submissions,
        learners: x.learners.size,
        firstAttempts: x.firstAttempts,
        firstCorrect: x.firstCorrect
      }))
  };
}


let glossaryTableReady = false;
async function ensureGlossaryTable(env) {
  if (glossaryTableReady) return;
  await env.DB.prepare(`CREATE TABLE IF NOT EXISTS glossary_events (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    client_event_id TEXT NOT NULL UNIQUE,
    installation_id TEXT NOT NULL,
    cohort TEXT NOT NULL,
    app_version TEXT,
    chabura TEXT,
    chabura_region TEXT,
    client_ts TEXT,
    received_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now')),
    term_id TEXT NOT NULL,
    term TEXT NOT NULL,
    source TEXT NOT NULL,
    question_id INTEGER,
    category TEXT,
    mode TEXT NOT NULL CHECK (mode IN ('study','test')),
    country TEXT,
    region TEXT,
    region_code TEXT,
    city TEXT,
    timezone TEXT,
    metro_code TEXT,
    latitude_rounded REAL,
    longitude_rounded REAL
  )`).run();
  await env.DB.prepare('CREATE INDEX IF NOT EXISTS idx_glossary_received_at ON glossary_events(received_at)').run();
  await env.DB.prepare('CREATE INDEX IF NOT EXISTS idx_glossary_cohort ON glossary_events(cohort)').run();
  await env.DB.prepare('CREATE INDEX IF NOT EXISTS idx_glossary_term ON glossary_events(term_id)').run();
  await env.DB.prepare('CREATE INDEX IF NOT EXISTS idx_glossary_location ON glossary_events(country, region, city)').run();
  await env.DB.prepare('CREATE INDEX IF NOT EXISTS idx_glossary_category ON glossary_events(category)').run();
  glossaryTableReady = true;
}


let resourceTableReady = false;
async function ensureResourceTable(env) {
  if (resourceTableReady) return;
  await env.DB.prepare(`CREATE TABLE IF NOT EXISTS resource_events (
    id INTEGER PRIMARY KEY AUTOINCREMENT, client_event_id TEXT NOT NULL UNIQUE, installation_id TEXT NOT NULL,
    cohort TEXT NOT NULL, app_version TEXT, chabura TEXT, chabura_region TEXT, client_ts TEXT,
    received_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now')),
    resource_type TEXT NOT NULL CHECK (resource_type IN ('audio','notes')), resource_id TEXT NOT NULL,
    resource_label TEXT NOT NULL, resource_variant TEXT, page INTEGER, source TEXT, context_kind TEXT, context_id TEXT,
    category TEXT, mode TEXT NOT NULL CHECK (mode IN ('study','test')),
    country TEXT, region TEXT, region_code TEXT, city TEXT, timezone TEXT, metro_code TEXT,
    latitude_rounded REAL, longitude_rounded REAL
  )`).run();
  await env.DB.prepare('CREATE INDEX IF NOT EXISTS idx_resource_received_at ON resource_events(received_at)').run();
  await env.DB.prepare('CREATE INDEX IF NOT EXISTS idx_resource_cohort ON resource_events(cohort)').run();
  await env.DB.prepare('CREATE INDEX IF NOT EXISTS idx_resource_type_id ON resource_events(resource_type,resource_id)').run();
  await env.DB.prepare('CREATE INDEX IF NOT EXISTS idx_resource_location ON resource_events(country,region,city)').run();
  await env.DB.prepare('CREATE INDEX IF NOT EXISTS idx_resource_category ON resource_events(category)').run();
  await env.DB.prepare('CREATE INDEX IF NOT EXISTS idx_resource_chabura ON resource_events(chabura)').run();
  resourceTableReady = true;
}

let essayTablesReady = false;
async function ensureEssayTables(env) {
  if (essayTablesReady) return;
  await env.DB.prepare(`CREATE TABLE IF NOT EXISTS essay_round_events (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    client_event_id TEXT NOT NULL UNIQUE,
    installation_id TEXT NOT NULL,
    cohort TEXT NOT NULL,
    app_version TEXT,
    chabura TEXT,
    chabura_region TEXT,
    client_ts TEXT,
    received_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now')),
    event_type TEXT NOT NULL CHECK (event_type IN ('essay_round_start','essay_round_complete')),
    round_id TEXT NOT NULL,
    session_id TEXT NOT NULL,
    essay_id TEXT NOT NULL,
    source TEXT NOT NULL,
    attempt_in_round INTEGER NOT NULL,
    total_facts INTEGER NOT NULL,
    first_try_correct INTEGER,
    total_wrong INTEGER,
    perfect INTEGER,
    duration_bucket TEXT,
    essay_content_hash TEXT,
    country TEXT, region TEXT, region_code TEXT, city TEXT, timezone TEXT, metro_code TEXT,
    latitude_rounded REAL, longitude_rounded REAL
  )`).run();
  await env.DB.prepare(`CREATE TABLE IF NOT EXISTS essay_pairing_events (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    client_event_id TEXT NOT NULL UNIQUE,
    installation_id TEXT NOT NULL,
    cohort TEXT NOT NULL,
    app_version TEXT,
    chabura TEXT,
    chabura_region TEXT,
    client_ts TEXT,
    received_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now')),
    round_id TEXT NOT NULL,
    session_id TEXT NOT NULL,
    essay_id TEXT NOT NULL,
    fact_id TEXT NOT NULL,
    step_index INTEGER NOT NULL,
    first_try INTEGER NOT NULL,
    presented_choice_ids_json TEXT NOT NULL,
    wrong_choice_ids_json TEXT NOT NULL,
    response_time_bucket TEXT NOT NULL,
    fact_content_hash TEXT,
    audio_used INTEGER NOT NULL DEFAULT 0,
    country TEXT, region TEXT, region_code TEXT, city TEXT, timezone TEXT, metro_code TEXT,
    latitude_rounded REAL, longitude_rounded REAL
  )`).run();
  const indexes = [
    'CREATE INDEX IF NOT EXISTS idx_essay_round_received ON essay_round_events(received_at)',
    'CREATE INDEX IF NOT EXISTS idx_essay_round_essay ON essay_round_events(essay_id, event_type)',
    'CREATE INDEX IF NOT EXISTS idx_essay_round_install_essay ON essay_round_events(installation_id, essay_id)',
    'CREATE INDEX IF NOT EXISTS idx_essay_round_round ON essay_round_events(round_id)',
    'CREATE INDEX IF NOT EXISTS idx_essay_pair_received ON essay_pairing_events(received_at)',
    'CREATE INDEX IF NOT EXISTS idx_essay_pair_fact ON essay_pairing_events(essay_id, fact_id)',
    'CREATE INDEX IF NOT EXISTS idx_essay_pair_install_fact ON essay_pairing_events(installation_id, fact_id)',
    'CREATE INDEX IF NOT EXISTS idx_essay_pair_round ON essay_pairing_events(round_id)'
  ];
  for (const sql of indexes) await env.DB.prepare(sql).run();
  essayTablesReady = true;
}


let chaburaStorageReady = false;
const CHABURA_SCHEMA_MARKER_KEY = 'analytics_core_schema';
const CHABURA_SCHEMA_MARKER_VERSION = '2026-10-05-v1';
async function ensureChaburaStorage(env) {
  if (chaburaStorageReady) return;
  try {
    const marker = await env.DB.prepare('SELECT schema_version FROM runtime_schema_meta WHERE schema_key=?').bind(CHABURA_SCHEMA_MARKER_KEY).first();
    if (marker?.schema_version === CHABURA_SCHEMA_MARKER_VERSION) {
      glossaryTableReady = true;
      resourceTableReady = true;
      essayTablesReady = true;
      chaburaStorageReady = true;
      return;
    }
  } catch (_) {
    // Older and fresh databases do not have the marker yet; run the full idempotent migration below.
  }
  await ensureGlossaryTable(env);
  await ensureResourceTable(env);
  await ensureEssayTables(env);
  const tables = ['events', 'glossary_events', 'resource_events', 'essay_round_events', 'essay_pairing_events'];
  for (const table of tables) {
    const info = resultsOf(await env.DB.prepare(`PRAGMA table_info(${table})`).all());
    const columns = new Set(info.map(row => String(row.name)));
    for (const column of ['chabura', 'chabura_region']) {
      if (columns.has(column)) continue;
      try { await env.DB.prepare(`ALTER TABLE ${table} ADD COLUMN ${column} TEXT`).run(); }
      catch (error) {
        if (!/duplicate column/i.test(String(error?.message || error))) throw error;
      }
    }
  }
  await env.DB.prepare(`CREATE TABLE IF NOT EXISTS learner_profiles (
    installation_id TEXT PRIMARY KEY,
    cohort TEXT NOT NULL,
    chabura TEXT NOT NULL,
    chabura_region TEXT NOT NULL,
    updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now'))
  )`).run();
  await env.DB.prepare('CREATE INDEX IF NOT EXISTS idx_learner_profiles_chabura ON learner_profiles(chabura)').run();
  await env.DB.prepare('CREATE INDEX IF NOT EXISTS idx_events_chabura ON events(chabura)').run();
  await env.DB.prepare('CREATE INDEX IF NOT EXISTS idx_glossary_chabura ON glossary_events(chabura)').run();
  await env.DB.prepare('CREATE INDEX IF NOT EXISTS idx_resource_chabura ON resource_events(chabura)').run();
  await env.DB.prepare('CREATE INDEX IF NOT EXISTS idx_essay_round_chabura ON essay_round_events(chabura)').run();
  await env.DB.prepare('CREATE INDEX IF NOT EXISTS idx_essay_pair_chabura ON essay_pairing_events(chabura)').run();
  for (const legacy of LEGACY_ZMAN_KEYS) {
    if (!legacy || legacy === CURRENT_ZMAN) continue;
    for (const table of ['events', 'glossary_events', 'resource_events', 'essay_round_events', 'essay_pairing_events', 'learner_profiles']) {
      await env.DB.prepare(`UPDATE ${table} SET cohort=? WHERE cohort=?`).bind(CURRENT_ZMAN, legacy).run();
    }
  }
  await env.DB.prepare(`CREATE TABLE IF NOT EXISTS runtime_schema_meta (
    schema_key TEXT PRIMARY KEY,
    schema_version TEXT NOT NULL,
    updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now'))
  )`).run();
  await env.DB.prepare(`INSERT INTO runtime_schema_meta(schema_key,schema_version,updated_at)
    VALUES(?,?,strftime('%Y-%m-%dT%H:%M:%fZ','now'))
    ON CONFLICT(schema_key) DO UPDATE SET schema_version=excluded.schema_version,updated_at=excluded.updated_at`)
    .bind(CHABURA_SCHEMA_MARKER_KEY, CHABURA_SCHEMA_MARKER_VERSION).run();
  chaburaStorageReady = true;
}

function normalizeChaburaFields(raw, required = false) {
  const chabura = text(raw?.chabura, 180);
  const chaburaRegion = text(raw?.chaburaRegion, 100);
  if ((chabura && !chaburaRegion) || (!chabura && chaburaRegion) || (required && (!chabura || !chaburaRegion))) {
    throw new Error('Malformed chabura profile');
  }
  return { chabura, chaburaRegion };
}

function normalizeProfileEvent(raw) {
  if (!raw || typeof raw !== 'object') throw new Error('Invalid profile event');
  const eventId = text(raw.eventId, 100);
  const installationId = text(raw.installationId, 100);
  const cohort = normalizeZman(raw.zman ?? raw.cohort);
  const appVersion = text(raw.appVersion, 32);
  const profile = normalizeChaburaFields(raw, true);
  if (!eventId || !installationId || !cohort) throw new Error('Malformed profile event');
  catalogForZman(cohort);
  return {
    kind: 'profile', eventId, installationId, cohort, appVersion,
    clientTs: validIsoDate(raw.clientTs), ...profile
  };
}

function normalizeEvent(raw) {
  if (!raw || typeof raw !== 'object') throw new Error('Invalid event');
  const eventId = text(raw.eventId, 100);
  const installationId = text(raw.installationId, 100);
  const cohort = normalizeZman(raw.zman ?? raw.cohort);
  const catalog = catalogForZman(cohort);
  const questionId = Number(raw.questionId);
  const q = catalog.questionMap.get(questionId);
  if (!q) throw new Error('Unknown question');
  const appVersion = text(raw.appVersion, 32);
  const mode = text(raw.mode, 10);
  const result = text(raw.result, 16);
  const attemptNumber = Math.trunc(Number(raw.attemptNumber));
  const bucket = text(raw.responseTimeBucket, 16);
  const profile = normalizeChaburaFields(raw);
  if (!eventId || !installationId || !cohort || !MODES.has(mode) || !RESULTS.has(result) || !Number.isInteger(attemptNumber) || attemptNumber < 1 || attemptNumber > 10000 || !RESPONSE_BUCKETS.has(bucket)) throw new Error('Malformed event');
  const validLetters = new Set(q.choices.map((_, i) => String.fromCharCode(65 + i)));
  const selected = [...new Set((Array.isArray(raw.selected) ? raw.selected : []).map(x => String(x).toUpperCase()).filter(x => validLetters.has(x)))].sort();
  if (!selected.length) throw new Error('Missing selection');
  const credit = clamp(Number(raw.credit) || 0, 0, 1);
  return {
    eventId, installationId, cohort, appVersion, clientTs: validIsoDate(raw.clientTs), questionId,
    category: q.category, mode, attemptNumber, result, credit, selected, bucket,
    audioUsed: boolInt(raw.audioUsed), glossaryUsed: boolInt(raw.glossaryUsed), ...profile
  };
}

function normalizeGlossaryEvent(raw) {
  if (!raw || typeof raw !== 'object') throw new Error('Invalid glossary event');
  const eventId = text(raw.eventId, 100);
  const installationId = text(raw.installationId, 100);
  const cohort = normalizeZman(raw.zman ?? raw.cohort);
  const appVersion = text(raw.appVersion, 32);
  const mode = text(raw.mode, 10);
  const sourceRaw = text(raw.source, 20) || 'other';
  const source = GLOSSARY_SOURCES.has(sourceRaw) ? sourceRaw : 'other';
  const termId = text(raw.termId, 80);
  const term = text(raw.term, 140);
  const catalog = catalogForZman(cohort);
  const rawQuestionId = Number(raw.questionId);
  const q = Number.isInteger(rawQuestionId) ? catalog.questionMap.get(rawQuestionId) : null;
  const profile = normalizeChaburaFields(raw);
  if (!eventId || !installationId || !cohort || !MODES.has(mode) || !termId || !term || !/^[a-z0-9][a-z0-9-]{0,79}$/i.test(termId)) {
    throw new Error('Malformed glossary event');
  }
  return {
    kind: 'glossary',
    eventId, installationId, cohort, appVersion,
    clientTs: validIsoDate(raw.clientTs),
    termId, term, source, mode,
    questionId: q ? rawQuestionId : null,
    category: q?.category || null,
    ...profile
  };
}


function normalizeResourceEvent(raw) {
  if (!raw || typeof raw !== 'object') throw new Error('Invalid resource event');
  const eventId=text(raw.eventId,100), installationId=text(raw.installationId,100), cohort=normalizeZman(raw.zman??raw.cohort);
  const catalog=catalogForZman(cohort), appVersion=text(raw.appVersion,32), resourceType=text(raw.resourceType,16);
  const resourceId=text(raw.resourceId,220), resourceLabel=text(raw.resourceLabel,240), resourceVariant=text(raw.resourceVariant,300);
  const source=text(raw.source,40)||'other', contextKind=text(raw.contextKind,30)||'other', contextId=text(raw.contextId,120), mode=text(raw.mode,10);
  const rawPage=Number(raw.page), page=Number.isInteger(rawPage)&&rawPage>=1&&rawPage<=10000?rawPage:null;
  let category=text(raw.category,160);
  if(contextKind==='question'&&contextId){const q=catalog.questionMap.get(Number(contextId));if(q)category=q.category;}
  const profile=normalizeChaburaFields(raw);
  if(!eventId||!installationId||!cohort||!['audio','notes'].includes(resourceType)||!resourceId||!resourceLabel||!MODES.has(mode)) throw new Error('Malformed resource event');
  return {kind:'resource',eventId,installationId,cohort,appVersion,clientTs:validIsoDate(raw.clientTs),resourceType,resourceId,resourceLabel,resourceVariant,page,source,contextKind,contextId,category,mode,...profile};
}

function normalizeEssayIdentity(raw) {
  const eventId = text(raw.eventId, 100);
  const installationId = text(raw.installationId, 100);
  const cohort = normalizeZman(raw.zman ?? raw.cohort);
  const appVersion = text(raw.appVersion, 32);
  const roundId = text(raw.roundId, 100);
  const sessionId = text(raw.sessionId, 100);
  const essayId = text(raw.essayId, 100);
  const catalog = catalogForZman(cohort);
  const essay = essayId ? catalog.essayMap.get(essayId) : null;
  const profile = normalizeChaburaFields(raw);
  if (!eventId || !installationId || !cohort || !roundId || !sessionId || !essay) throw new Error('Malformed essay event');
  return { eventId, installationId, cohort, appVersion, clientTs: validIsoDate(raw.clientTs), roundId, sessionId, essayId, essay, catalog, ...profile };
}

function normalizeEssayRoundEvent(raw) {
  const base = normalizeEssayIdentity(raw);
  const kind = text(raw.kind, 32);
  if (kind !== 'essay_round_start' && kind !== 'essay_round_complete') throw new Error('Unknown essay round event');
  const source = text(raw.source, 20);
  const attemptInRound = Math.trunc(Number(raw.attemptInRound));
  const totalFacts = Math.trunc(Number(raw.totalFacts));
  const essayContentHash = text(raw.essayContentHash, 80);
  if (!ESSAY_SOURCES.has(source) || !Number.isInteger(attemptInRound) || attemptInRound < 1 || attemptInRound > 1000 ||
      !Number.isInteger(totalFacts) || totalFacts !== (base.essay.facts || []).length || !essayContentHash) {
    throw new Error('Malformed essay round event');
  }
  let firstTryCorrect = null, totalWrong = null, perfect = null, durationBucket = null;
  if (kind === 'essay_round_complete') {
    firstTryCorrect = Math.trunc(Number(raw.firstTryCorrect));
    totalWrong = Math.trunc(Number(raw.totalWrong));
    durationBucket = text(raw.durationBucket, 16);
    if (!Number.isInteger(firstTryCorrect) || firstTryCorrect < 0 || firstTryCorrect > totalFacts ||
        !Number.isInteger(totalWrong) || totalWrong < 0 || !RESPONSE_BUCKETS.has(durationBucket) ||
        typeof raw.perfect !== 'boolean') throw new Error('Malformed essay completion');
    perfect = boolInt(raw.perfect);
  }
  return {
    kind, ...base, source, attemptInRound, totalFacts, firstTryCorrect, totalWrong, perfect, durationBucket, essayContentHash
  };
}

function normalizeEssayPairingEvent(raw) {
  const base = normalizeEssayIdentity(raw);
  const factId = text(raw.factId, 100);
  const mapped = factId ? base.catalog.essayFactMap.get(factId) : null;
  if (!mapped || String(mapped.essay.id) !== base.essayId) throw new Error('Unknown essay pairing');
  const validFactIds = new Set((base.essay.facts || []).map(fact => String(fact.id)));
  const presented = [...new Set((Array.isArray(raw.presentedChoiceIds) ? raw.presentedChoiceIds : []).map(x => String(x)).filter(x => validFactIds.has(x)))];
  const wrong = [...new Set((Array.isArray(raw.wrongChoiceIds) ? raw.wrongChoiceIds : []).map(x => String(x)).filter(x => validFactIds.has(x) && x !== factId))];
  const stepIndex = Math.trunc(Number(raw.stepIndex));
  const bucket = text(raw.responseTimeBucket, 16);
  const factContentHash = text(raw.factContentHash, 80);
  if (!presented.includes(factId) || presented.length < 1 || presented.length > 10 ||
      wrong.some(id => !presented.includes(id)) || !Number.isInteger(stepIndex) || stepIndex < 1 || stepIndex > validFactIds.size ||
      typeof raw.firstTry !== 'boolean' || !RESPONSE_BUCKETS.has(bucket) || !factContentHash) {
    throw new Error('Malformed essay pairing event');
  }
  return {
    kind: 'essay_pairing', ...base, factId, stepIndex, firstTry: boolInt(raw.firstTry),
    presented, wrong, bucket, factContentHash, audioUsed: boolInt(raw.audioUsed)
  };
}

function normalizeIncomingEvent(raw) {
  if (raw?.kind === 'profile') return normalizeProfileEvent(raw);
  if (raw?.kind === 'glossary') return normalizeGlossaryEvent(raw);
  if (raw?.kind === 'resource') return normalizeResourceEvent(raw);
  if (raw?.kind === 'essay_round_start' || raw?.kind === 'essay_round_complete') return normalizeEssayRoundEvent(raw);
  if (raw?.kind === 'essay_pairing') return normalizeEssayPairingEvent(raw);
  return { kind: 'answer', ...normalizeEvent(raw) };
}

async function ingestEvents(request, env) {
  const cors = eventCors(request, env);
  if (!cors) return jsonResponse({ error: 'Origin not allowed' }, { status: 403 });
  const length = Number(request.headers.get('Content-Length') || 0);
  if (length > 100000) return jsonResponse({ error: 'Payload too large' }, { status: 413, headers: cors });
  let body;
