wers</span></div></div><div class=\"hour-grid\">${cols}</div><div class=\"peak-list\">${peaks}</div><div class=\"sample-note\">Times are normalized to each student’s stored Cloudflare timezone before aggregation.</div>`}\nfunction showToast(message){const t=$('toast');t.textContent=message;t.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>t.classList.remove('show'),3200)}\nfunction filterSummary(){const parts=[];filters.forEach(id=>{const e=$(id);if(e.value)parts.push(`${e.previousElementSibling?.textContent||id}: ${e.options?e.options[e.selectedIndex]?.text:e.value}`)});return parts.length?parts.join(' · '):'All recorded activity'}\nfunction renderAll(d){currentData=d;catalog=new Map((d.questionCatalog||[]).map(q=>[q.id,q]));renderOverview(d.overview);renderNeedsReview(d.questions);renderHeatmap(d.topics);renderTopics(d.topics);renderLocations(d.locations);renderQuestions(d.questions);renderTimeline(d.timeline);renderPeakTimes(d.activity)}\nfunction showQuestion(qid){if(!currentData)return;const r=currentData.questions.find(x=>x.questionId===Number(qid)),q=catalog.get(Number(qid));if(!r||!q)return;const correct=new Set(q.answer||[]);$('questionDialogTitle').textContent=`Question ${q.id}`;$('questionDialogSubtitle').textContent=`${q.category} · ${r.learners} learners · ${r.attempts} recorded answers`;const choices=(r.choiceDistribution||[]).map(x=>{const idx=x.letter.charCodeAt(0)-65,choice=q.choices[idx]||'',isCorrect=correct.has(x.letter);return `<div class=\"dist-row\"><div class=\"dist-label ${isCorrect?'correct':''}\">${isCorrect?'✓ ':''}<strong>${esc(x.letter)}.</strong> ${esc(choice)}</div><div class=\"track\"><div class=\"fill\" style=\"width:${r.attempts?100*x.selected/r.attempts:0}%;${isCorrect?'background:linear-gradient(90deg,#25855a,#57af82)':''}\"></div></div><div class=\"dist-values\"><b>${pct(x.selected,r.attempts)}</b>${x.selected}/${r.attempts}<br>first ${pct(x.firstSelected,r.firstAttempts)}</div></div>`}).join('');const combos=(r.answerCombos||[]).slice(0,6).map(x=>`<li><strong>${esc(x.letters.join('+'))}</strong> — ${x.count} answer${x.count===1?'':'s'} (${pct(x.count,r.attempts)}), ${x.firstCount} first attempts</li>`).join('');$('questionDialogBody').innerHTML=`<p class=\"modal-prompt\">${esc(q.prompt)}</p><div class=\"modal-metrics\"><div class=\"modal-metric\"><b class=\"${pctClass(r.firstCorrect,r.firstAttempts)}\">${pct(r.firstCorrect,r.firstAttempts)}</b><span>First-attempt accuracy · n=${r.firstAttempts}</span></div><div class=\"modal-metric\"><b>${pct(r.eventualCorrect,r.pairs)}</b><span>Eventually correct · n=${r.pairs}</span></div><div class=\"modal-metric\"><b>${pct(r.recovered,r.firstMissed)}</b><span>Recovered after miss · n=${r.firstMissed}</span></div><div class=\"modal-metric\"><b>${esc(dominantTime(r.timeBuckets)||'—')}</b><span>Most common response-time range</span></div></div><div class=\"dist-title\">Answer distribution</div>${choices}${q.type==='multi'?'<div class=\"sample-note\">This is a select-all-that-apply question, so choice-selection percentages can total more than 100%.</div>':''}${combos?`<div class=\"dist-title\">Most common submitted answer${q.type==='multi'?' sets':'s'}</div><ol class=\"combo-list\">${combos}</ol>`:''}<div class=\"sample-note\">All percentages reflect the current dashboard filters. “First” is the distribution among first attempts only.</div>`;$('questionDialog').showModal()}\nasync function loadSummary({announce=false}={}){if(busy)return;const before=announce&&currentData?{learners:Number(currentData.overview?.learners)||0,submissions:Number(currentData.overview?.submissions)||0}:null;busy=true;$('main').classList.add('loading');$('error').classList.add('hidden');$('refreshData').disabled=true;try{const d=await getJSON('/api/summary'+(query()?`?${query()}`:''));renderAll(d);$('updated').textContent=`Updated ${new Date().toLocaleTimeString([], {hour:'numeric',minute:'2-digit'})}`;$('filterSummary').textContent=filterSummary();syncUrl();if(announce){const newStudents=Math.max(0,(Number(d.overview?.learners)||0)-(before?.learners||0));const newAnswers=Math.max(0,(Number(d.overview?.submissions)||0)-(before?.submissions||0));if(newStudents||newAnswers)showToast(`${newStudents} new student${newStudents===1?'':'s'} and ${newAnswers} new answer${newAnswers===1?'':'s'} loaded.`);else showToast('Dashboard refreshed — no new students or answers in this view.')}}catch(e){$('error').textContent='Could not load dashboard data: '+e.message;$('error').classList.remove('hidden');if(announce)showToast('Refresh failed. Please try again.')}finally{busy=false;$('main').classList.remove('loading');$('refreshData').disabled=false}}\nfunction applyUrlFilters(){const p=new URLSearchParams(location.search);filters.forEach(id=>{const v=p.get(id);if(v!==null)$(id).value=v});cascadeLocation();if(p.has('region'))$('region').value=p.get('region')||'';cascadeLocation();if(p.has('city'))$('city').value=p.get('city')||''}\nasync function init(){try{options=await getJSON('/api/options');fillSelect('cohort',options.cohorts||[]);fillSelect('country',[...new Set((options.locations||[]).map(x=>x.country).filter(Boolean))].sort(),countryName);fillSelect('category',options.categories||[]);cascadeLocation();if(location.search)applyUrlFilters();else if((options.cohorts||[]).includes('SCP 2026 Summer'))$('cohort').value='SCP 2026 Summer'}catch(e){$('error').textContent='Could not load filters: '+e.message;$('error').classList.remove('hidden')}filters.forEach(id=>$(id).addEventListener('change',()=>{if(id==='country'||id==='region')cascadeLocation();loadSummary()}));$('clearFilters').addEventListener('click',()=>{filters.forEach(id=>$(id).value='');cascadeLocation();loadSummary()});$('refreshData').addEventListener('click',()=>loadSummary({announce:true}));$('topicsSort').addEventListener('change',()=>currentData&&renderTopics(currentData.topics));$('questionsSort').addEventListener('change',()=>currentData&&renderQuestions(currentData.questions));document.addEventListener('click',e=>{const b=e.target.closest('[data-qid]');if(b)showQuestion(b.dataset.qid)});$('closeQuestionDialog').addEventListener('click',()=>$('questionDialog').close());$('questionDialog').addEventListener('click',e=>{if(e.target===$('questionDialog'))$('questionDialog').close()});loadSummary()}init();\n</script>\n</body></html>\n";
