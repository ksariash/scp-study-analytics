  try { body = await request.json(); } catch (_) { return jsonResponse({ error: 'Invalid JSON' }, { status: 400, headers: cors }); }
  const incoming = Array.isArray(body?.events) ? body.events : [];
  if (!incoming.length || incoming.length > 50) return jsonResponse({ error: 'Send 1–50 events' }, { status: 400, headers: cors });
  let events;
  try { events = incoming.map(normalizeIncomingEvent); } catch (err) { return jsonResponse({ error: err.message || 'Invalid event' }, { status: 400, headers: cors }); }

  await ensureChaburaStorage(env);

  const cf = request.cf || {};
  const geo = {
    country: text(cf.country, 8), region: text(cf.region, 100), regionCode: text(cf.regionCode, 20), city: text(cf.city, 100),
    timezone: text(cf.timezone, 80), metroCode: text(cf.metroCode, 20), latitude: roundCoord(cf.latitude), longitude: roundCoord(cf.longitude)
  };
  const answerSql = `INSERT OR IGNORE INTO events (
    client_event_id, installation_id, cohort, app_version, chabura, chabura_region, client_ts, question_id, category, mode, attempt_number, result, credit,
    selected_json, response_time_bucket, audio_used, glossary_used, country, region, region_code, city, timezone, metro_code, latitude_rounded, longitude_rounded
  ) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)`;
  const glossarySql = `INSERT OR IGNORE INTO glossary_events (
    client_event_id, installation_id, cohort, app_version, chabura, chabura_region, client_ts, term_id, term, source, question_id, category, mode,
    country, region, region_code, city, timezone, metro_code, latitude_rounded, longitude_rounded
  ) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)`;
  const resourceSql = `INSERT OR IGNORE INTO resource_events (
    client_event_id, installation_id, cohort, app_version, chabura, chabura_region, client_ts, resource_type, resource_id, resource_label,
    resource_variant, page, source, context_kind, context_id, category, mode,
    country, region, region_code, city, timezone, metro_code, latitude_rounded, longitude_rounded
  ) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)`;
  const essayRoundSql = `INSERT OR IGNORE INTO essay_round_events (
    client_event_id, installation_id, cohort, app_version, chabura, chabura_region, client_ts, event_type, round_id, session_id, essay_id, source,
    attempt_in_round, total_facts, first_try_correct, total_wrong, perfect, duration_bucket, essay_content_hash,
    country, region, region_code, city, timezone, metro_code, latitude_rounded, longitude_rounded
  ) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)`;
  const essayPairingSql = `INSERT OR IGNORE INTO essay_pairing_events (
    client_event_id, installation_id, cohort, app_version, chabura, chabura_region, client_ts, round_id, session_id, essay_id, fact_id, step_index,
    first_try, presented_choice_ids_json, wrong_choice_ids_json, response_time_bucket, fact_content_hash, audio_used,
    country, region, region_code, city, timezone, metro_code, latitude_rounded, longitude_rounded
  ) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)`;
  const profileEvents = events.filter(e => e.kind === 'profile');
  const answers = events.filter(e => e.kind === 'answer');
  const glossaryEvents = events.filter(e => e.kind === 'glossary');
  const resourceEvents = events.filter(e => e.kind === 'resource');
  const essayRoundEvents = events.filter(e => e.kind === 'essay_round_start' || e.kind === 'essay_round_complete');
  const essayPairingEvents = events.filter(e => e.kind === 'essay_pairing');
  const statements = [
    ...answers.map(e => env.DB.prepare(answerSql).bind(
      e.eventId, e.installationId, e.cohort, e.appVersion, e.chabura, e.chaburaRegion, e.clientTs, e.questionId, e.category, e.mode, e.attemptNumber, e.result, e.credit,
      JSON.stringify(e.selected), e.bucket, e.audioUsed, e.glossaryUsed, geo.country, geo.region, geo.regionCode, geo.city, geo.timezone, geo.metroCode, geo.latitude, geo.longitude
    )),
    ...glossaryEvents.map(e => env.DB.prepare(glossarySql).bind(
      e.eventId, e.installationId, e.cohort, e.appVersion, e.chabura, e.chaburaRegion, e.clientTs, e.termId, e.term, e.source, e.questionId, e.category, e.mode,
      geo.country, geo.region, geo.regionCode, geo.city, geo.timezone, geo.metroCode, geo.latitude, geo.longitude
    )),
    ...resourceEvents.map(e => env.DB.prepare(resourceSql).bind(
      e.eventId,e.installationId,e.cohort,e.appVersion,e.chabura,e.chaburaRegion,e.clientTs,e.resourceType,e.resourceId,e.resourceLabel,
      e.resourceVariant,e.page,e.source,e.contextKind,e.contextId,e.category,e.mode,
      geo.country,geo.region,geo.regionCode,geo.city,geo.timezone,geo.metroCode,geo.latitude,geo.longitude
    )),
    ...essayRoundEvents.map(e => env.DB.prepare(essayRoundSql).bind(
      e.eventId, e.installationId, e.cohort, e.appVersion, e.chabura, e.chaburaRegion, e.clientTs, e.kind, e.roundId, e.sessionId, e.essayId, e.source,
      e.attemptInRound, e.totalFacts, e.firstTryCorrect, e.totalWrong, e.perfect, e.durationBucket, e.essayContentHash,
      geo.country, geo.region, geo.regionCode, geo.city, geo.timezone, geo.metroCode, geo.latitude, geo.longitude
    )),
    ...essayPairingEvents.map(e => env.DB.prepare(essayPairingSql).bind(
      e.eventId, e.installationId, e.cohort, e.appVersion, e.chabura, e.chaburaRegion, e.clientTs, e.roundId, e.sessionId, e.essayId, e.factId, e.stepIndex,
      e.firstTry, JSON.stringify(e.presented), JSON.stringify(e.wrong), e.bucket, e.factContentHash, e.audioUsed,
      geo.country, geo.region, geo.regionCode, geo.city, geo.timezone, geo.metroCode, geo.latitude, geo.longitude
    ))
  ];
  if (statements.length) await env.DB.batch(statements);

  for (const profile of profileEvents) {
    const profileStatements = [
      env.DB.prepare(`INSERT INTO learner_profiles (installation_id, cohort, chabura, chabura_region, updated_at)
        VALUES (?,?,?,?,strftime('%Y-%m-%dT%H:%M:%fZ','now'))
        ON CONFLICT(installation_id) DO UPDATE SET cohort=excluded.cohort, chabura=excluded.chabura,
          chabura_region=excluded.chabura_region, updated_at=excluded.updated_at`)
        .bind(profileStorageId(profile.cohort, profile.installationId), profile.cohort, profile.chabura, profile.chaburaRegion),
      env.DB.prepare('UPDATE events SET chabura=?, chabura_region=? WHERE installation_id=? AND cohort=?').bind(profile.chabura, profile.chaburaRegion, profile.installationId, profile.cohort),
      env.DB.prepare('UPDATE glossary_events SET chabura=?, chabura_region=? WHERE installation_id=? AND cohort=?').bind(profile.chabura, profile.chaburaRegion, profile.installationId, profile.cohort),
      env.DB.prepare('UPDATE resource_events SET chabura=?, chabura_region=? WHERE installation_id=? AND cohort=?').bind(profile.chabura, profile.chaburaRegion, profile.installationId, profile.cohort),
      env.DB.prepare('UPDATE essay_round_events SET chabura=?, chabura_region=? WHERE installation_id=? AND cohort=?').bind(profile.chabura, profile.chaburaRegion, profile.installationId, profile.cohort),
      env.DB.prepare('UPDATE essay_pairing_events SET chabura=?, chabura_region=? WHERE installation_id=? AND cohort=?').bind(profile.chabura, profile.chaburaRegion, profile.installationId, profile.cohort)
    ];
    await env.DB.batch(profileStatements);
  }

  return jsonResponse({
    ok: true, accepted: events.length, profiles: profileEvents.length, answers: answers.length, glossary: glossaryEvents.length, resources: resourceEvents.length,
    essayRounds: essayRoundEvents.length, essayPairings: essayPairingEvents.length
  }, { headers: cors });
}

async function dashboardOptions(env) {
  await ensureChaburaStorage(env);
  const [cohorts, chaburaProfiles, locations] = await Promise.all([
    env.DB.prepare(`SELECT DISTINCT cohort FROM (
      SELECT cohort FROM events
      UNION ALL
      SELECT cohort FROM essay_round_events
    ) WHERE cohort IS NOT NULL AND cohort != '' ORDER BY cohort DESC`).all(),
    env.DB.prepare(`SELECT DISTINCT chabura_region, chabura FROM (
      SELECT chabura_region, chabura FROM learner_profiles
      UNION ALL
      SELECT chabura_region, chabura FROM events
      UNION ALL
      SELECT chabura_region, chabura FROM essay_round_events
    ) WHERE chabura_region IS NOT NULL AND chabura_region != ''
      AND chabura IS NOT NULL AND chabura != ''
    ORDER BY chabura_region, chabura`).all(),
    env.DB.prepare(`SELECT DISTINCT country, region, region_code, city FROM (
      SELECT country, region, region_code, city FROM events
      UNION ALL
      SELECT country, region, region_code, city FROM essay_round_events
    ) WHERE country IS NOT NULL ORDER BY country, region, city`).all()
  ]);
  const profiles = resultsOf(chaburaProfiles).map(row => ({
    location: row.chabura_region,
    rav: row.chabura
  }));
  const configured = ZMAN_OPTIONS.map(zman => String(zman.id || '')).filter(Boolean);
  const observed = resultsOf(cohorts).map(x => normalizeZman(x.cohort)).filter(Boolean);
  const latestZmanId = String(ANALYTICS_ZMAN_REGISTRY?.latestZmanId || ANALYTICS_ZMAN_REGISTRY?.defaultZmanId || configured[0] || '');
  return jsonResponse({
    cohorts: [...new Set([...configured, ...observed])],
    zmanim: [...new Set([...configured, ...observed])],
    zmanOptions: ZMAN_OPTIONS.map(zman => ({ id:String(zman.id), name:String(zman.name || zman.id), status:zman.status || '', startsOn:zman.startsOn || null })),
    latestZmanId,
    chaburaLocations: [...new Set(profiles.map(x => x.location).filter(Boolean))],
    chaburaProfiles: profiles,
    chaburos: [...new Set(profiles.map(x => x.rav).filter(Boolean))],
    locations: resultsOf(locations),
    categories: [...new Set(QUESTION_CATALOG.map(q => q.category))],
    categoriesByZman: { [CURRENT_ZMAN]: [...new Set(QUESTION_CATALOG.map(q => q.category))] }
  });
}

function combineRows(primary, secondary, key = 'category') {
  const secondaryMap = new Map(secondary.map(r => [String(r[key]), r]));
  return primary.map(row => ({ ...row, ...(secondaryMap.get(String(row[key])) || {}) }));
}

async function dashboardSummary(request, env) {
  const url = new URL(request.url);
  if (!url.searchParams.get('zman') && !url.searchParams.get('cohort')) url.searchParams.set('zman', CURRENT_ZMAN);
  let catalog;
  try { catalog = catalogForZman(url.searchParams.get('zman') || url.searchParams.get('cohort') || CURRENT_ZMAN); }
  catch (error) { return jsonResponse({ error: error.message === 'Unsupported zman' ? 'Select a supported zman' : error.message }, { status: 400 }); }
  const questionMap = catalog.questionMap;
  const questionCatalog = catalog.questions;
  const { where, params } = queryFilter(url);
  await ensureChaburaStorage(env);
  const baseOverview = stmt(env, `SELECT COUNT(*) submissions, COUNT(DISTINCT installation_id) learners,
      SUM(CASE WHEN attempt_number = 1 THEN 1 ELSE 0 END) first_attempts,
      SUM(CASE WHEN attempt_number = 1 AND result = 'correct' THEN 1 ELSE 0 END) first_correct,
      SUM(audio_used) audio_used, SUM(glossary_used) glossary_used
    FROM events ${where}`, params);
  const pairOverview = stmt(env, `SELECT COUNT(*) pairs, SUM(any_correct) eventual_correct FROM (
      SELECT installation_id, question_id, MAX(CASE WHEN result='correct' THEN 1 ELSE 0 END) any_correct
      FROM events ${where} GROUP BY installation_id, question_id
    )`, params);
  const topicBasic = stmt(env, `SELECT category, COUNT(*) attempts, COUNT(DISTINCT installation_id) learners,
      SUM(CASE WHEN attempt_number=1 THEN 1 ELSE 0 END) first_attempts,
      SUM(CASE WHEN attempt_number=1 AND result='correct' THEN 1 ELSE 0 END) first_correct,
      SUM(audio_used) audio_used, SUM(glossary_used) glossary_used
    FROM events ${where} GROUP BY category`, params);
  const topicPairs = stmt(env, `SELECT category, COUNT(*) pairs, SUM(any_correct) eventual_correct,
      SUM(CASE WHEN had_first=1 AND first_correct=0 THEN 1 ELSE 0 END) first_missed,
      SUM(CASE WHEN had_first=1 AND first_correct=0 AND any_correct=1 AND attempts>1 THEN 1 ELSE 0 END) recovered
    FROM (
      SELECT category, installation_id, question_id, COUNT(*) attempts,
        MAX(CASE WHEN attempt_number=1 THEN 1 ELSE 0 END) had_first,
        MAX(CASE WHEN attempt_number=1 AND result='correct' THEN 1 ELSE 0 END) first_correct,
        MAX(CASE WHEN result='correct' THEN 1 ELSE 0 END) any_correct
      FROM events ${where} GROUP BY category, installation_id, question_id
    ) GROUP BY category`, params);
  const questionBasic = stmt(env, `SELECT question_id, category, COUNT(*) attempts, COUNT(DISTINCT installation_id) learners,
      SUM(CASE WHEN attempt_number=1 THEN 1 ELSE 0 END) first_attempts,
      SUM(CASE WHEN attempt_number=1 AND result='correct' THEN 1 ELSE 0 END) first_correct,
      SUM(audio_used) audio_used, SUM(glossary_used) glossary_used
    FROM events ${where} GROUP BY question_id, category`, params);
  const questionPairs = stmt(env, `SELECT question_id, COUNT(*) pairs, SUM(any_correct) eventual_correct,
      SUM(CASE WHEN had_first=1 AND first_correct=0 THEN 1 ELSE 0 END) first_missed,
      SUM(CASE WHEN had_first=1 AND first_correct=0 AND any_correct=1 AND attempts>1 THEN 1 ELSE 0 END) recovered
    FROM (
      SELECT question_id, installation_id, COUNT(*) attempts,
        MAX(CASE WHEN attempt_number=1 THEN 1 ELSE 0 END) had_first,
        MAX(CASE WHEN attempt_number=1 AND result='correct' THEN 1 ELSE 0 END) first_correct,
        MAX(CASE WHEN result='correct' THEN 1 ELSE 0 END) any_correct
      FROM events ${where} GROUP BY question_id, installation_id
    ) GROUP BY question_id`, params);
  const selectionRows = stmt(env, `SELECT question_id, selected_json, COUNT(*) n,
      SUM(CASE WHEN attempt_number=1 THEN 1 ELSE 0 END) first_n
    FROM events ${where} GROUP BY question_id, selected_json ORDER BY question_id, n DESC`, params);
  const questionTimeRows = stmt(env, `SELECT question_id, response_time_bucket, COUNT(*) n
    FROM events ${where} GROUP BY question_id, response_time_bucket ORDER BY question_id, n DESC`, params);
  const topicTimeRows = stmt(env, `SELECT category, response_time_bucket, COUNT(*) n
    FROM events ${where} GROUP BY category, response_time_bucket ORDER BY category, n DESC`, params);
  const locations = stmt(env, `SELECT country, region, region_code, city, COUNT(DISTINCT installation_id) learners, COUNT(*) submissions,
      SUM(CASE WHEN attempt_number=1 THEN 1 ELSE 0 END) first_attempts,
      SUM(CASE WHEN attempt_number=1 AND result='correct' THEN 1 ELSE 0 END) first_correct
    FROM events ${where} GROUP BY country, region, region_code, city ORDER BY learners DESC, submissions DESC LIMIT 200`, params);
  const timeline = stmt(env, `SELECT substr(received_at,1,10) day, COUNT(*) submissions, COUNT(DISTINCT installation_id) learners,
      SUM(CASE WHEN attempt_number=1 THEN 1 ELSE 0 END) first_attempts,
      SUM(CASE WHEN attempt_number=1 AND result='correct' THEN 1 ELSE 0 END) first_correct
