    FROM events ${where} GROUP BY substr(received_at,1,10) ORDER BY day`, params).all();
  const activityRows = stmt(env, `SELECT COALESCE(client_ts, received_at) ts, timezone, installation_id, attempt_number, result
    FROM events ${where} ORDER BY received_at`, params).all();
  const glossaryRows = stmt(env, `SELECT term_id, MAX(term) term, COUNT(*) clicks, COUNT(DISTINCT installation_id) learners,
      SUM(CASE WHEN source='question' THEN 1 ELSE 0 END) question_clicks,
      SUM(CASE WHEN source='materials' THEN 1 ELSE 0 END) materials_clicks,
      SUM(CASE WHEN julianday(received_at) >= julianday('now','-7 days') THEN 1 ELSE 0 END) recent_7d,
      SUM(CASE WHEN julianday(received_at) >= julianday('now','-14 days') AND julianday(received_at) < julianday('now','-7 days') THEN 1 ELSE 0 END) prior_7d,
      MIN(received_at) first_seen, MAX(received_at) last_seen
    FROM glossary_events ${where} GROUP BY term_id ORDER BY clicks DESC`, params).all();
  const glossaryRepeatRows = stmt(env, `SELECT term_id, COUNT(*) learners_with_clicks,
      SUM(CASE WHEN clicks > 1 THEN 1 ELSE 0 END) repeat_learners,
      SUM(CASE WHEN clicks > 1 THEN clicks - 1 ELSE 0 END) repeat_clicks
    FROM (
      SELECT term_id, installation_id, COUNT(*) clicks
      FROM glossary_events ${where}
      GROUP BY term_id, installation_id
    ) GROUP BY term_id`, params).all();


  const [overviewA, overviewB, topicA, topicB, questionA, questionB, selections, questionTimes, topicTimes, locationRows, timelineRows, activityRaw, glossaryRaw, glossaryRepeatsRaw] = await Promise.all([
    baseOverview, pairOverview, topicBasic, topicPairs, questionBasic, questionPairs, selectionRows, questionTimeRows, topicTimeRows, locations, timeline, activityRows, glossaryRows, glossaryRepeatRows
  ]);

  const selectionMap = new Map();
  const choiceMap = new Map();
  const wrongMap = new Map();
  const wrongCountMap = new Map();
  const wrongTotalMap = new Map();
  for (const row of resultsOf(selections)) {
    const qid = Number(row.question_id);
    const q = QUESTION_MAP.get(qid);
    let letters = [];
    try { letters = JSON.parse(row.selected_json); } catch (_) { letters = []; }
    if (!Array.isArray(letters)) letters = [];
    const n = Number(row.n) || 0;
    const firstN = Number(row.first_n) || 0;
    if (!selectionMap.has(qid)) selectionMap.set(qid, []);
    selectionMap.get(qid).push({ letters, count: n, firstCount: firstN });
    if (!choiceMap.has(qid)) choiceMap.set(qid, new Map());
    const cm = choiceMap.get(qid);
    for (const letter of letters) {
      const prior = cm.get(letter) || { selected: 0, firstSelected: 0 };
      prior.selected += n;
      prior.firstSelected += firstN;
      cm.set(letter, prior);
    }
    const correct = q ? [...q.answer].sort().join('|') : '';
    const submitted = [...letters].sort().join('|');
    if (submitted !== correct) {
      wrongTotalMap.set(qid, (wrongTotalMap.get(qid) || 0) + n);
      if ((wrongCountMap.get(qid) || 0) < n) {
        wrongMap.set(qid, letters);
        wrongCountMap.set(qid, n);
      }
    }
  }

  const questionTimeMap = new Map();
  for (const row of resultsOf(questionTimes)) {
    const qid = Number(row.question_id);
    if (!questionTimeMap.has(qid)) questionTimeMap.set(qid, []);
    questionTimeMap.get(qid).push({ bucket: row.response_time_bucket, n: Number(row.n) || 0 });
  }
  const topicTimeMap = new Map();
  for (const row of resultsOf(topicTimes)) {
    const category = String(row.category || '');
    if (!topicTimeMap.has(category)) topicTimeMap.set(category, []);
    topicTimeMap.get(category).push({ bucket: row.response_time_bucket, n: Number(row.n) || 0 });
  }

  const topics = combineRows(resultsOf(topicA), resultsOf(topicB)).map(r => ({
    category: r.category, attempts: Number(r.attempts)||0, learners: Number(r.learners)||0,
    firstAttempts: Number(r.first_attempts)||0, firstCorrect: Number(r.first_correct)||0,
    audioUsed: Number(r.audio_used)||0, glossaryUsed: Number(r.glossary_used)||0,
    pairs: Number(r.pairs)||0, eventualCorrect: Number(r.eventual_correct)||0,
    firstMissed: Number(r.first_missed)||0, recovered: Number(r.recovered)||0,
    timeBuckets: topicTimeMap.get(String(r.category || '')) || []
  }));
  const questions = combineRows(resultsOf(questionA), resultsOf(questionB), 'question_id').map(r => {
    const qid = Number(r.question_id);
    const q = QUESTION_MAP.get(qid);
    const cm = choiceMap.get(qid) || new Map();
    const choiceDistribution = (q?.choices || []).map((_, i) => {
      const letter = String.fromCharCode(65 + i);
      const counts = cm.get(letter) || { selected: 0, firstSelected: 0 };
      return { letter, selected: counts.selected, firstSelected: counts.firstSelected };
    });
    return {
      questionId: qid, category: r.category, attempts: Number(r.attempts)||0, learners: Number(r.learners)||0,
      firstAttempts: Number(r.first_attempts)||0, firstCorrect: Number(r.first_correct)||0,
      audioUsed: Number(r.audio_used)||0, glossaryUsed: Number(r.glossary_used)||0,
      pairs: Number(r.pairs)||0, eventualCorrect: Number(r.eventual_correct)||0,
      firstMissed: Number(r.first_missed)||0, recovered: Number(r.recovered)||0,
      commonWrong: wrongMap.get(qid) || [], commonWrongCount: wrongCountMap.get(qid) || 0,
      wrongAttempts: wrongTotalMap.get(qid) || 0,
      timeBuckets: questionTimeMap.get(qid) || [],
      choiceDistribution,
      answerCombos: (selectionMap.get(qid) || []).sort((a,b) => b.count - a.count)
    };
  });
  const activity = localActivity(resultsOf(activityRaw));
  const glossaryRepeatMap = new Map(resultsOf(glossaryRepeatsRaw).map(r => [String(r.term_id), r]));
  const glossaryTerms = resultsOf(glossaryRaw).map(r => {
    const repeat = glossaryRepeatMap.get(String(r.term_id)) || {};
    return {
      termId: r.term_id,
      term: r.term,
      clicks: Number(r.clicks) || 0,
      learners: Number(r.learners) || 0,
      questionClicks: Number(r.question_clicks) || 0,
      materialsClicks: Number(r.materials_clicks) || 0,
      recent7d: Number(r.recent_7d) || 0,
      prior7d: Number(r.prior_7d) || 0,
      repeatLearners: Number(repeat.repeat_learners) || 0,
      repeatClicks: Number(repeat.repeat_clicks) || 0,
      firstSeen: r.first_seen || null,
      lastSeen: r.last_seen || null
    };
  });
  return jsonResponse({
    generatedAt: new Date().toISOString(),
    overview: {
      submissions: Number(overviewA?.submissions)||0, learners: Number(overviewA?.learners)||0,
      firstAttempts: Number(overviewA?.first_attempts)||0, firstCorrect: Number(overviewA?.first_correct)||0,
      audioUsed: Number(overviewA?.audio_used)||0, glossaryUsed: Number(overviewA?.glossary_used)||0,
      pairs: Number(overviewB?.pairs)||0, eventualCorrect: Number(overviewB?.eventual_correct)||0
    },
    topics, questions, locations: resultsOf(locationRows).map(r => ({
      country:r.country, region:r.region, regionCode:r.region_code, city:r.city, learners:Number(r.learners)||0,
      submissions:Number(r.submissions)||0, firstAttempts:Number(r.first_attempts)||0, firstCorrect:Number(r.first_correct)||0
    })),
    timeline: activity.days,
    activity,
    glossaryTerms,
    questionCatalog: QUESTION_CATALOG
  });
}


function essayAnalyticsFilter(url) {
  const clauses = [];
  const params = [];
  for (const [param, column] of [
    ['chaburaRegion','chabura_region'], ['chabura','chabura'], ['zman','cohort'], ['cohort','cohort'],
    ['country','country'], ['region','region'], ['city','city']
  ]) {
    const value = text(url.searchParams.get(param), 160);
    if (value) { clauses.push(`${column} = ?`); params.push(value); }
  }
  const from = text(url.searchParams.get('from'), 10);
  const to = text(url.searchParams.get('to'), 10);
  if (from && /^\d{4}-\d{2}-\d{2}$/.test(from)) { clauses.push('received_at >= ?'); params.push(`${from}T00:00:00.000Z`); }
  if (to && /^\d{4}-\d{2}-\d{2}$/.test(to)) {
    const d = new Date(`${to}T00:00:00.000Z`); d.setUTCDate(d.getUTCDate() + 1);
    clauses.push('received_at < ?'); params.push(d.toISOString());
  }
  return { where: clauses.length ? `WHERE ${clauses.join(' AND ')}` : '', params };
}

function contentHash(value) {
  let hash = 2166136261;
  const input = String(value || '');
  for (let i = 0; i < input.length; i++) {
    hash ^= input.charCodeAt(i);
    hash = Math.imul(hash, 16777619);
  }
  return (hash >>> 0).toString(16).padStart(8, '0');
}

function currentEssayHash(essay) {
  return contentHash([
    essay.prompt || '',
    ...(essay.facts || []).map(fact => `${fact.name || fact.label || ''} → ${fact.position || ''}`),
    essay.modelAnswer || ''
  ].join('\n'));
}
function currentFactHash(fact) {
  return contentHash(`${fact.name || fact.label || ''} → ${fact.position || ''}`);
}
function parseIdArray(value) {
  try { const parsed = JSON.parse(value || '[]'); return Array.isArray(parsed) ? parsed.map(String) : []; }
  catch (_) { return []; }
}

async function dashboardEssaySummary(request, env) {
  await ensureChaburaStorage(env);
  const url = new URL(request.url);
  let catalog;
  try { catalog = catalogForZman(url.searchParams.get('zman') || url.searchParams.get('cohort')); }
  catch (error) { return jsonResponse({ error: error.message === 'Unsupported zman' ? 'Select a supported zman' : error.message }, { status: 400 }); }
  const essayCatalog = catalog.essays;
  const essayMap = catalog.essayMap;
  const essayFactMap = catalog.essayFactMap;
  const filter = essayAnalyticsFilter(url);
  const [roundResult, pairingResult] = await Promise.all([
    stmt(env, `SELECT installation_id, event_type, round_id, session_id, essay_id, source, attempt_in_round, total_facts,
        first_try_correct, total_wrong, perfect, duration_bucket, essay_content_hash, received_at
      FROM essay_round_events ${filter.where} ORDER BY received_at`, filter.params).all(),
    stmt(env, `SELECT installation_id, round_id, session_id, essay_id, fact_id, step_index, first_try,
        presented_choice_ids_json, wrong_choice_ids_json, response_time_bucket, fact_content_hash, audio_used, received_at
      FROM essay_pairing_events ${filter.where} ORDER BY received_at`, filter.params).all()
  ]);
  const rounds = resultsOf(roundResult);
  const pairings = resultsOf(pairingResult);
  const overallLearners = new Set();

  const essayStats = new Map(essayCatalog.map(essay => [String(essay.id), {
    essayId: String(essay.id), title: essay.title, learners: new Set(), starts: 0, completions: 0, perfect: 0,
    pairings: 0, firstTry: 0, wrongChoices: 0, audioUsed: 0,
    sources: { adaptive: 0, library: 0, retry: 0, next: 0 },
    currentStarts: 0, olderStarts: 0
  }]));
  for (const row of rounds) {
    const stat = essayStats.get(String(row.essay_id));
    if (!stat) continue;
    if (row.installation_id) { stat.learners.add(String(row.installation_id)); overallLearners.add(String(row.installation_id)); }
    const essay = essayMap.get(String(row.essay_id));
    const isCurrent = essay && row.essay_content_hash === currentEssayHash(essay);
    if (row.event_type === 'essay_round_start') {
      stat.starts += 1;
      if (stat.sources[row.source] != null) stat.sources[row.source] += 1;
      if (isCurrent) stat.currentStarts += 1; else stat.olderStarts += 1;
    } else if (row.event_type === 'essay_round_complete') {
      stat.completions += 1;
      stat.perfect += Number(row.perfect) ? 1 : 0;
    }
  }

  const factStats = new Map();
  for (const essay of essayCatalog) {
    for (const fact of essay.facts || []) {
      factStats.set(String(fact.id), {
        essayId: String(essay.id), essayTitle: essay.title, factId: String(fact.id), label: fact.label,
        name: fact.name, position: fact.position, learners: new Set(), exposures: 0, firstTry: 0,
        wrongTotal: 0, audioUsed: 0, currentExposures: 0, olderExposures: 0,
        offered: new Map(), wrong: new Map(), timeBuckets: new Map()
      });
    }
  }

  for (const row of pairings) {
    const essayStat = essayStats.get(String(row.essay_id));
    const stat = factStats.get(String(row.fact_id));
    if (!stat || !essayStat) continue;
    const learner = String(row.installation_id || '');
    if (learner) {
      stat.learners.add(learner);
      essayStat.learners.add(learner);
      overallLearners.add(learner);
    }
    stat.exposures += 1;
    essayStat.pairings += 1;
    if (Number(row.first_try)) { stat.firstTry += 1; essayStat.firstTry += 1; }
    stat.audioUsed += Number(row.audio_used) || 0;
    essayStat.audioUsed += Number(row.audio_used) || 0;
    const wrong = parseIdArray(row.wrong_choice_ids_json);
    const presented = parseIdArray(row.presented_choice_ids_json);
    stat.wrongTotal += wrong.length;
    essayStat.wrongChoices += wrong.length;
    const current = essayFactMap.get(String(row.fact_id));
    if (current && row.fact_content_hash === currentFactHash(current.fact)) stat.currentExposures += 1;
    else stat.olderExposures += 1;
    stat.timeBuckets.set(String(row.response_time_bucket || ''), (stat.timeBuckets.get(String(row.response_time_bucket || '')) || 0) + 1);
    for (const id of presented) {
      if (id === stat.factId) continue;
      stat.offered.set(id, (stat.offered.get(id) || 0) + 1);
    }
    for (const id of wrong) stat.wrong.set(id, (stat.wrong.get(id) || 0) + 1);
  }

  const essays = [...essayStats.values()].map(stat => ({
    essayId: stat.essayId, title: stat.title, learners: stat.learners.size, starts: stat.starts, completions: stat.completions,
    completionRate: stat.starts ? stat.completions / stat.starts : 0,
    perfect: stat.perfect, perfectRate: stat.completions ? stat.perfect / stat.completions : 0,
    pairings: stat.pairings, firstTry: stat.firstTry, firstTryRate: stat.pairings ? stat.firstTry / stat.pairings : 0,
    avgWrong: stat.pairings ? stat.wrongChoices / stat.pairings : 0, audioUsed: stat.audioUsed,
    sources: stat.sources, currentStarts: stat.currentStarts, olderStarts: stat.olderStarts
  }));

  const facts = [...factStats.values()].map(stat => {
    const confusion = [...stat.offered.entries()].map(([factId, offered]) => {
      const wrong = stat.wrong.get(factId) || 0;
      const mapped = essayFactMap.get(factId);
      return {
        factId, name: mapped?.fact?.name || factId, position: mapped?.fact?.position || '',
        offered, wrong, rate: offered ? wrong / offered : 0
      };
    }).sort((a,b) => b.wrong - a.wrong || b.rate - a.rate || b.offered - a.offered);
    return {
      essayId: stat.essayId, essayTitle: stat.essayTitle, factId: stat.factId, label: stat.label, name: stat.name, position: stat.position,
      learners: stat.learners.size, exposures: stat.exposures, firstTry: stat.firstTry,
      firstTryRate: stat.exposures ? stat.firstTry / stat.exposures : 0,
      avgWrong: stat.exposures ? stat.wrongTotal / stat.exposures : 0,
      audioUsed: stat.audioUsed, currentExposures: stat.currentExposures, olderExposures: stat.olderExposures,
      timeBuckets: [...stat.timeBuckets.entries()].filter(([bucket]) => bucket).map(([bucket,n]) => ({ bucket, n })),
      mostConfusedWith: confusion[0] || null, confusion
    };
  });

  const starts = rounds.filter(row => row.event_type === 'essay_round_start').length;
  const completions = rounds.filter(row => row.event_type === 'essay_round_complete').length;
  const perfectRounds = rounds.filter(row => row.event_type === 'essay_round_complete' && Number(row.perfect)).length;
  const firstTryPairings = pairings.reduce((sum,row) => sum + (Number(row.first_try) ? 1 : 0), 0);
  return jsonResponse({
    generatedAt: new Date().toISOString(),
    note: 'Essay analytics are practice diagnostics. Adaptive selection intentionally changes which essays and facts receive more exposure.',
    overview: {
      learners: overallLearners.size, starts, completions, completionRate: starts ? completions / starts : 0,
      pairingExposures: pairings.length, firstTryPairings, firstTryRate: pairings.length ? firstTryPairings / pairings.length : 0,
      perfectRounds, perfectRate: completions ? perfectRounds / completions : 0,
      audioUsed: pairings.reduce((sum,row) => sum + (Number(row.audio_used) || 0), 0)
    },
    essays, facts
  });
}

export default {
  async fetch(request, env) {
    const url = new URL(request.url);
    if (request.method === 'OPTIONS' && url.pathname === '/api/events') {
      const cors = eventCors(request, env);
      return cors ? new Response(null, { status: 204, headers: cors }) : new Response(null, { status: 403 });
    }
    if (request.method === 'POST' && url.pathname === '/api/events') return ingestEvents(request, env);
    if (request.method === 'GET' && url.pathname === '/api/health') return jsonResponse({ ok: true, service: 'scp-study-analytics', version: 19 });
    if (request.method === 'GET' && url.pathname === '/api/options') return dashboardOptions(env);
    if (request.method === 'GET' && url.pathname === '/api/summary') return dashboardSummary(request, env);
    if (request.method === 'GET' && url.pathname === '/api/essay-summary') return dashboardEssaySummary(request, env);
    if (request.method === 'GET' && (url.pathname === '/' || url.pathname === '/dashboard')) return dashboardResponse();
    return new Response('Not found', { status: 404, headers: { 'X-Robots-Tag': 'noindex, nofollow' } });
  }
};
